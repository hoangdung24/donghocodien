---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { Providers } from '@/components/Providers';
import Head from '@/components/Head.astro';
import '@/styles/global.css';
import type { ApproxPricingVisibility } from '@/lib/utils/visual';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'product';
  itunesAppId?: string;
  approximatePricing?: ApproxPricingVisibility;
  heroImage?: { src: string; srcset: string; sizes: string };
  product?: {
    name: string;
    brand: string;
    sku: string;
    price?: number;
    currency: string;
    availability: 'in_stock' | 'out_of_stock';
    url: string;
    image: string;
  };
}

const {
  title,
  description,
  image,
  type = 'website',
  itunesAppId,
  approximatePricing,
  heroImage,
  product,
} = Astro.props;
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta name='generator' content={Astro.generator} />
    <Head
      title={title}
      description={description}
      image={image}
      type={type}
      itunesAppId={itunesAppId}
      product={product}
    />
    <slot name='head' />
    {heroImage && (
      <link
        rel='preload'
        as='image'
        href={heroImage.src}
        imagesrcset={heroImage.srcset}
        imagesizes={heroImage.sizes}
        fetchpriority='high'
      />
    )}
  </head>
  <body
    class:list={[
      'flex min-h-screen flex-col bg-stone-50 text-stone-900',
      approximatePricing?.className,
    ]}
  >
    <a class='skip-link' href='#main-content'>
      Skip to content
    </a>
    <Header />
    <div id='main-content' class='flex-1' tabindex='-1'>
      <Providers client:only='react'>
        <slot />
      </Providers>
    </div>
    <div id='page-pending-slot'>
      <slot name='before-footer' />
    </div>
    <Footer />
  </body>
</html>
