---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = 'Dong Ho Co Dien — Curating rare, authentic vintage timepieces from Switzerland and Japan for global collectors.',
  image = 'https://donghocodien.com/wp-content/uploads/2025/09/ref-200246-1-1.jpg',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://donghocodien.com');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    {/* Primary Meta Tags */}
    <title>{title} | Dong Ho Co Dien</title>
    <meta name="title" content={`${title} | Dong Ho Co Dien`} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    {/* Open Graph / Facebook */}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | Dong Ho Co Dien`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    {/* Twitter */}
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={`${title} | Dong Ho Co Dien`} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    {/* Web Fonts */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col bg-stone-50 text-stone-900">
    <Header />
    <div class="flex-1">
      <slot />
    </div>
    <Footer />

    {/* Client-side currency exchange rate sync with 6-hour local cache */}
    <script>
      import { getClientExchangeRate, formatApproxVND } from '../lib/utils/currency';

      getClientExchangeRate().then((rate) => {
        if (!rate || rate <= 0) return;
        document.querySelectorAll<HTMLElement>('.approximate-vnd').forEach((el) => {
          const usd = Number(el.dataset.usdPrice);
          if (usd && !isNaN(usd)) {
            el.textContent = formatApproxVND(usd, rate);
          }
        });
      });
    </script>
  </body>
</html>
