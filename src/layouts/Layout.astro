---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { Providers } from '@/components/Providers';
import Head from '@/components/Head.astro';
import '@/styles/global.css';
import { COUNTRY_COOKIE } from '@/lib/utils/geo';
import { APPROX_PRICING_VISIBILITY_CLASS } from '@/lib/utils/visual';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'product';
  itunesAppId?: string;
  heroImage?: { src: string; srcset: string; sizes: string };
  product?: {
    name: string;
    brand: string;
    sku: string;
    price?: number;
    currency: string;
    availability: 'in_stock' | 'out_of_stock';
    url: string;
    image: string;
  };
}

const {
  title,
  description,
  image,
  type = 'website',
  itunesAppId,
  heroImage,
  product,
} = Astro.props;
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta name='generator' content={Astro.generator} />
    <Head
      title={title}
      description={description}
      image={image}
      type={type}
      itunesAppId={itunesAppId}
      product={product}
    />
    <slot name='head' />
    <script
      is:inline
      define:vars={{
        countryCookieName: COUNTRY_COOKIE,
        hideClassName: APPROX_PRICING_VISIBILITY_CLASS,
      }}
    >
      (() => {
        const match = document.cookie.match(
          new RegExp('(?:^|;\\s*)' + countryCookieName + '=([A-Za-z]{2})')
        );
        const country = match ? match[1].toUpperCase() : null;
        if (!country || country === 'US') {
          document.documentElement.classList.add(hideClassName);
        }
      })();
    </script>
    {heroImage && (
      <link
        rel='preload'
        as='image'
        href={heroImage.src}
        imagesrcset={heroImage.srcset}
        imagesizes={heroImage.sizes}
        fetchpriority='high'
      />
    )}
  </head>
  <body class='flex min-h-screen flex-col bg-stone-50 text-stone-900'>
    <a class='skip-link' href='#main-content'>
      Skip to content
    </a>
    <Header />
    <div id='main-content' class='flex-1' tabindex='-1'>
      <Providers client:only='react'>
        <slot />
      </Providers>
    </div>
    <div id='page-pending-slot'>
      <slot name='before-footer' />
    </div>
    <Footer />
  </body>
</html>
