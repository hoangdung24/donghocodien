---
import Layout from '../../layouts/Layout.astro';
import { WatchGallery } from '../../components/WatchGallery';
import { AddToCartButton } from '../../components/AddToCartButton';
import { ProductTabs } from '../../components/ProductTabs';
import { RelatedProducts } from '../../components/RelatedProducts';
import { Effect } from 'effect';
import type { Product, ProductCategory } from '../../lib/schema/product';
import { getAllProducts, getBrandCategories, getCategories } from '../../lib/services/woocommerce';
import { findBrandCategory } from '../../lib/utils/categories';
import { sanitizeWordPressHtml } from '../../lib/utils/html';
import { cleanTitle } from '../../lib/utils/text';

export const prerender = true;

export const getStaticPaths = async () => {
  const [catalog, categories, brands] = await Effect.runPromise(
    Effect.all([getAllProducts, getCategories, getBrandCategories], { concurrency: 'unbounded' })
  );

  const brandIds = brands.map((brand) => brand.id);
  const availableProducts = catalog.filter(
    (product) => product.is_in_stock && Number(product.prices.price) > 0
  );

  return availableProducts.map((product) => ({
    params: { slug: decodeURIComponent(product.slug) },
    props: { product, catalog, categories, brandIds },
  }));
};

const product: Product = Astro.props.product;
const allProducts: Product[] = Astro.props.catalog;
const categories: ProductCategory[] = Astro.props.categories;
const brandIds: number[] = Astro.props.brandIds;

const cleanName = cleanTitle(product.name);
const cleanDescription = await sanitizeWordPressHtml(product.description || '');
const cleanShortDescription = await sanitizeWordPressHtml(product.short_description || '');
const primaryBrand = findBrandCategory(product, categories);

const relatedProducts = primaryBrand
  ? allProducts
      .filter(
        (relatedProduct) =>
          relatedProduct.id !== product.id &&
          relatedProduct.is_in_stock &&
          relatedProduct.categories.some((category) => brandIds.includes(category.id))
      )
      .slice(0, 4)
  : [];

const stockText = product.is_in_stock
  ? `${product.low_stock_remaining ? `${product.low_stock_remaining} in stock` : 'In stock'}`
  : 'Out of stock';
const stockClass = product.is_in_stock ? 'text-green-700' : 'text-stone-500';

const productSchema = {
  name: cleanName,
  brand: primaryBrand?.name || 'Spacetime Vintage Watch',
  sku: product.sku || product.id.toString(),
  price: Number(product.prices.price),
  currency: 'USD',
  availability: product.is_in_stock ? ('in_stock' as const) : ('out_of_stock' as const),
  url: `/products/${product.slug}`,
  image:
    product.images[0]?.src ||
    'https://donghocodien.com/wp-content/uploads/2025/09/ref-200246-1-1.jpg',
};
---

<Layout
  title={cleanName}
  description={product.short_description.replace(/<[^>]*>?/gm, '').slice(0, 160)}
  image={product.images[0]?.src}
  type='product'
  product={productSchema}
>
  <main class='mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-16 lg:px-8'>
    <nav class='mb-8 flex items-center gap-2 font-sans text-xs tracking-wider text-stone-500 uppercase'>
      <a href='/' class='transition-colors hover:text-stone-900'>
        Home
      </a>
      <span>/</span>
      <a href='/watches' class='transition-colors hover:text-stone-900'>
        Collection
      </a>
      {primaryBrand && (
        <>
          <span>/</span>
          <a
            href={`/watches?category=${primaryBrand.slug}`}
            class='transition-colors hover:text-stone-900'
          >
            {cleanTitle(primaryBrand.name)}
          </a>
        </>
      )}
      <span>/</span>
      <span class='max-w-xs truncate text-stone-900'>{cleanName}</span>
    </nav>

    <div class='grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-16'>
      <div class='lg:col-span-7'>
        <WatchGallery client:visible images={product.images} title={cleanName} />
      </div>

      <div class='flex flex-col lg:col-span-5'>
        {primaryBrand && (
          <p class='mb-4 text-xs font-medium tracking-[0.25em] uppercase'>
            {cleanTitle(primaryBrand.name)}
          </p>
        )}

        <h1 class='mb-7 text-3xl leading-tight font-normal text-stone-950 sm:text-4xl'>
          {cleanName}
        </h1>

        <div class='flex flex-col'>
          <div class='flex items-baseline gap-4'>
            <span class='text-3xl font-medium text-stone-900'>${product.prices.price}</span>
            {product.on_sale && product.prices.regular_price && (
              <span class='text-base text-stone-400 line-through'>
                ${product.prices.regular_price}
              </span>
            )}
          </div>
        </div>

        {cleanShortDescription && (
          <div class='mt-10 border-t border-stone-200 pt-7 text-sm leading-relaxed text-stone-700'>
            <div set:html={cleanShortDescription} />
          </div>
        )}

        <div class='mt-10'>
          <AddToCartButton
            client:visible
            product={product}
            stockText={stockText}
            stockClass={stockClass}
          />
        </div>
      </div>
    </div>

    <div class='mt-12 lg:mt-16'>
      <ProductTabs
        client:visible
        descriptionHtml={cleanDescription}
        sku={product.sku}
        shortDescription={cleanShortDescription}
      />

      {relatedProducts.length > 0 && (
        <RelatedProducts
          client:visible
          products={relatedProducts}
          title='Similar Watches'
          country={null}
          className='mt-12'
        />
      )}
    </div>
  </main>
</Layout>
