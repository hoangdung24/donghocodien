---
import Layout from '@/layouts/Layout.astro';
import { SITE, CONTACT } from '@/lib/constants';

export const prerender = true;
---

<Layout
  title='About Us – Spacetime'
  description='Vintage watches have long left deep imprints across time — marking decades, even centuries — evoking memories of a bygone era. Spacetime – Vintage Watch.'
>
  <main class='mx-auto max-w-4xl px-4 pt-16 pb-16 font-sans text-brand-dark sm:px-6 sm:pt-24 sm:pb-24 lg:px-8'>
    <div class='flex flex-col gap-6 text-sm leading-relaxed text-stone-700 sm:text-base'>
      <p>
        Vintage watches have long left deep imprints across time — marking decades, even centuries —
        evoking memories of a bygone era. Born with the mission to deliver timeless elegance to
        every wrist, {SITE.name} represents two precious moments we all hold dear: "Now and Here."
        With each passing second, we're reminded to live fully in the present — no matter the time,
        no matter the place.
      </p>

      <p>
        From wandering the world to expressing your unique style, wherever you are and whatever you
        do, {SITE.name} is always with you — here, now, and on your wrist.
      </p>

      <div class='flex flex-col gap-2 pt-6'>
        <h4 class='text-base font-bold sm:text-lg'>{SITE.fullName}</h4>
        <p class='text-sm text-stone-700'>
          <strong>Email:</strong>{' '}
          <a href={CONTACT.emailLink} class='hover:underline'>
            {CONTACT.email}
          </a>
        </p>
        <p class='text-sm text-stone-700'>
          <strong>WhatsApp:</strong>{' '}
          <a
            href={CONTACT.whatsappLink}
            target='_blank'
            rel='noopener noreferrer'
            class='hover:underline'
          >
            {CONTACT.whatsapp}
          </a>
        </p>
      </div>
    </div>
  </main>
</Layout>
