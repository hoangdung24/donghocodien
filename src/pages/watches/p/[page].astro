---
import CatalogPage from '../../../components/CatalogPage.astro';
import { Effect } from 'effect';
import type { ProductCategory } from '../../../lib/schema/product';
import { getAllProducts, getCategories } from '../../../lib/services/woocommerce';
import { filterCatalog } from '../../../lib/utils/catalog';
import { parseSearchQuery } from '../../../lib/utils/search';

export const prerender = false;

const PAGE_SIZE = 20;

const [catalog, categories] = await Effect.runPromise(
  Effect.all([getAllProducts, getCategories], { concurrency: 'unbounded' })
);

const url = Astro.url;
const requestedPage = Math.max(1, Number(url.searchParams.get('page') || '1') || 1);
const search = parseSearchQuery(url.searchParams);
const rawCategory = url.searchParams.get('category') ?? undefined;

const activeCategory: ProductCategory | null = rawCategory
  ? (categories.find((category) => category.slug === rawCategory) ?? null)
  : null;

const products = filterCatalog(
  catalog,
  categories,
  { page: requestedPage, search, categories, activeCategoryId: activeCategory?.id },
  PAGE_SIZE
);
---

<CatalogPage
  products={products}
  categories={categories}
  availableProducts={catalog}
  activeCategory={activeCategory}
  search={search}
  page={requestedPage}
  pageSize={PAGE_SIZE}
  basePath='/watches'
/>
