---
import WatchDetail from '@/components/WatchDetail.astro';
import { loadWatchDetail } from '@/lib/services/watchDetail';

export const prerender = false;

const slugParam = Astro.params.slug;
const requestedWatch = slugParam ? await loadWatchDetail(slugParam) : null;

if (!requestedWatch) {
  return Astro.rewrite('/404');
}

const { product, relatedProducts, categories } = requestedWatch;
---

<WatchDetail product={product} relatedProducts={relatedProducts} categories={categories} />
