---
import Layout from '@/layouts/Layout.astro';
import { Effect } from 'effect';
import { getPageBySlug, getPostBySlug } from '@/lib/services/woocommerce';
import { demoteEmbeddedHeadings, sanitizeWordPressHtml } from '@/lib/utils/html';
import { reserveEmbeddedMediaSpace } from '@/lib/utils/embeddedMedia';
import { cleanTitle } from '@/lib/utils/text';

export const prerender = false;

const slug = Astro.params.slug ?? '';
const [pageResult, postResult] = await Promise.all([
  Effect.runPromiseExit(getPageBySlug(slug)),
  Effect.runPromiseExit(getPostBySlug(slug)),
]);

const page = pageResult._tag === 'Success' ? pageResult.value : null;
const post = postResult._tag === 'Success' ? postResult.value : null;

if (!page && !post) {
  return Astro.rewrite('/404');
}

const entry = page ?? post!;
const cleanPageTitle = cleanTitle(entry.title.rendered);
const sanitizedHtmlContent = await sanitizeWordPressHtml(entry.content.rendered);
const demotedHtmlContent = await demoteEmbeddedHeadings(sanitizedHtmlContent);
const cleanHtmlContent = reserveEmbeddedMediaSpace(demotedHtmlContent);
---

<Layout
  title={`${cleanPageTitle} | Spacetime`}
  description={`${cleanPageTitle} — Spacetime Vintage Watch Atelier`}
>
  <main class='mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8'>
    <h1 class='mb-8 text-2xl leading-tight font-normal tracking-wide text-brand-dark sm:text-3xl'>
      {cleanPageTitle}
    </h1>
    <article
      class='prose max-w-none prose-stone prose-headings:font-normal prose-headings:tracking-wide prose-h2:text-2xl prose-h3:text-xl prose-p:text-sm prose-p:leading-relaxed prose-p:text-stone-700 sm:prose-p:text-base prose-table:w-full prose-table:border-collapse prose-td:border-b prose-td:border-stone-100 prose-td:py-2.5 prose-img:rounded-none prose-img:shadow-sm [&_iframe]:h-auto [&_iframe]:w-full [&_img[data-aspect-ratio]]:[aspect-ratio:attr(data-aspect-ratio)] [&_img[data-aspect-ratio]]:h-auto [&_img[data-aspect-ratio]]:w-full'
      set:html={cleanHtmlContent}
    />
  </main>
</Layout>
