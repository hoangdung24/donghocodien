---
import Layout from '../layouts/Layout.astro';
import { Effect } from 'effect';
import { getPageBySlug, getPostBySlug } from '../lib/services/woocommerce';
import { sanitizeWordPressHtml } from '../lib/utils/html';
import { cleanTitle } from '../lib/utils/text';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/404');
}

const postResult = await Effect.runPromiseExit(getPostBySlug(slug));
let contentItem: {
  title: string;
  content: string;
  date?: string;
  modified?: string;
  image?: string;
  isPost: boolean;
} | null = null;

if (postResult._tag === 'Success') {
  const post = postResult.value;
  contentItem = {
    title: post.title.rendered,
    content: post.content.rendered,
    date: post.date,
    image: post._embedded?.['wp:featuredmedia']?.[0]?.source_url,
    isPost: true,
  };
} else {
  const pageResult = await Effect.runPromiseExit(getPageBySlug(slug));
  if (pageResult._tag === 'Success') {
    const page = pageResult.value;
    contentItem = {
      title: page.title.rendered,
      content: page.content.rendered,
      date: page.date,
      modified: page.modified,
      isPost: false,
    };
  }
}

if (!contentItem) {
  return Astro.redirect('/404');
}

const cleanItemTitle = cleanTitle(contentItem.title);
const cleanHtmlContent = await sanitizeWordPressHtml(contentItem.content);
const formattedDate = contentItem.date
  ? new Date(contentItem.date).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null;

const articleSchema =
  contentItem.isPost && contentItem.date
    ? {
        title: cleanItemTitle,
        author: 'Spacetime Editorial',
        publishedTime: contentItem.date,
        modifiedTime: contentItem.modified || contentItem.date,
        section: 'Horology',
        tags: ['vintage watches', 'horology', 'collecting'],
      }
    : undefined;
---

<Layout
  title={`${cleanItemTitle} | Spacetime`}
  description={`${cleanItemTitle} — Spacetime Vintage Watch Atelier`}
  type={contentItem.isPost ? 'article' : 'website'}
  article={articleSchema}
>
  <main class='max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16'>
    <nav class='text-[11px] uppercase tracking-wider text-stone-400 mb-6'>
      <a href='/' class='hover:text-stone-800'>
        Home
      </a>{' '}
      /
      {contentItem.isPost ? (
        <>
          <a href='/articles' class='hover:text-stone-800'>
            Articles
          </a>{' '}
          /<span class='text-stone-800'>{cleanItemTitle}</span>
        </>
      ) : (
        <span class='text-stone-800'>{cleanItemTitle}</span>
      )}
    </nav>

    <div class='border-b border-stone-200 pb-6 mb-8'>
      <h1 class='text-2xl sm:text-4xl text-stone-900 font-serif font-normal uppercase tracking-[0.1em] leading-snug mb-3'>
        {cleanItemTitle}
      </h1>

      {formattedDate && (
        <p class='text-xs uppercase tracking-widest text-stone-400 font-sans'>
          Published on {formattedDate} &bull; Editorial Horology
        </p>
      )}
    </div>

    {contentItem.image && (
      <div class='mb-10 aspect-[16/9] overflow-hidden bg-stone-100 shadow-sm border border-stone-100'>
        <img src={contentItem.image} alt={cleanItemTitle} class='w-full h-full object-cover' />
      </div>
    )}

    <article
      class='prose prose-stone max-w-none prose-headings:font-serif prose-headings:font-normal prose-headings:tracking-wide prose-h2:text-2xl prose-h3:text-xl prose-p:text-sm sm:prose-p:text-base prose-p:leading-relaxed prose-p:text-stone-700 prose-img:rounded-none prose-img:shadow-sm prose-table:w-full prose-table:border-collapse prose-td:py-2.5 prose-td:border-b prose-td:border-stone-100'
      set:html={cleanHtmlContent}
    />
  </main>
</Layout>
