---
import type { WpPage } from '../lib/schema/page';
import type { Post } from '../lib/schema/post';
import Layout from '../layouts/Layout.astro';
import { Effect } from 'effect';
import { getPublishedSlugs, getStorePageBySlug } from '../lib/services/woocommerce';
import { sanitizeWordPressHtml } from '../lib/utils/html';
import { cleanTitle } from '../lib/utils/text';

export const prerender = true;

export const getStaticPaths = async () => {
  const publishedSlugs = await Effect.runPromise(getPublishedSlugs);

  const contentEntries = await Effect.runPromise(
    Effect.forEach(
      [...new Set(publishedSlugs)],
      (slug) =>
        Effect.gen(function* () {
          const entry = yield* Effect.exit(getStorePageBySlug(slug));
          return entry._tag === 'Success' ? { slug, entry: entry.value } : null;
        }),
      { concurrency: 4 }
    )
  );

  return contentEntries.flatMap((contentEntry) =>
    contentEntry
      ? [{ params: { slug: contentEntry.slug }, props: { entry: contentEntry.entry } }]
      : []
  );
};
const entry: WpPage | Post = Astro.props.entry;
const isPost = 'excerpt' in entry;
const title = cleanTitle(entry.title.rendered);
const cleanHtmlContent = await sanitizeWordPressHtml(entry.content.rendered);
const image = isPost ? entry._embedded?.['wp:featuredmedia']?.[0]?.source_url : undefined;
const date = entry.date;
const modified = isPost ? entry.date : entry.modified;

const formattedDate = date
  ? new Date(date).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null;

const articleSchema =
  isPost && date
    ? {
        title,
        author: 'Spacetime Editorial',
        publishedTime: date,
        modifiedTime: modified || date,
        section: 'Horology',
        tags: ['vintage watches', 'horology', 'collecting'],
      }
    : undefined;
---

<Layout
  title={`${title} | Spacetime`}
  description={`${title} — Spacetime Vintage Watch Atelier`}
  type={isPost ? 'article' : 'website'}
  article={articleSchema}
>
  <main class='mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8'>
    <nav class='mb-6 text-[11px] tracking-wider text-stone-400 uppercase'>
      <a href='/' class='hover:text-stone-800'>
        Home
      </a>{' '}
      /
      {isPost ? (
        <>
          <a href='/articles' class='hover:text-stone-800'>
            Articles
          </a>{' '}
          /<span class='text-stone-800'>{title}</span>
        </>
      ) : (
        <span class='text-stone-800'>{title}</span>
      )}
    </nav>

    <div class='mb-8 border-b border-stone-200 pb-6'>
      <h1 class='mb-3 text-2xl leading-snug font-normal tracking-widest text-stone-900 uppercase sm:text-4xl'>
        {title}
      </h1>

      {formattedDate && (
        <p class='font-sans text-xs tracking-widest text-stone-400 uppercase'>
          Published on {formattedDate} &bull; Editorial Horology
        </p>
      )}
    </div>

    {image && (
      <div class='mb-10 aspect-video overflow-hidden border border-stone-100 bg-stone-100 shadow-sm'>
        <img src={image} alt={title} class='h-full w-full object-cover' />
      </div>
    )}

    <article
      class='prose max-w-none prose-stone prose-headings:font-normal prose-headings:tracking-wide prose-h2:text-2xl prose-h3:text-xl prose-p:text-sm prose-p:leading-relaxed prose-p:text-stone-700 sm:prose-p:text-base prose-table:w-full prose-table:border-collapse prose-td:border-b prose-td:border-stone-100 prose-td:py-2.5 prose-img:rounded-none prose-img:shadow-sm'
      set:html={cleanHtmlContent}
    />
  </main>
</Layout>
