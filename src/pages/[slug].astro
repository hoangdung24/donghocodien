---
import Layout from '../layouts/Layout.astro';
import { Effect } from 'effect';
import { getPageBySlug } from '../lib/services/woocommerce';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/404');
}

// Fetch WordPress Page by Slug using Effect
const result = await Effect.runPromiseExit(getPageBySlug(slug));

if (result._tag === 'Failure') {
  return Astro.redirect('/404');
}

const page = result.value;

function cleanTitle(title: string) {
  return title
    .replace(/&#8216;/g, '‘')
    .replace(/&#8217;/g, '’')
    .replace(/&#8211;/g, '–')
    .replace(/&#038;/g, '&')
    .replace(/&amp;/g, '&');
}

const cleanPageTitle = cleanTitle(page.title.rendered);
---

<Layout
  title={cleanPageTitle}
  description={`${cleanPageTitle} — Spacetime Vintage Watch`}
>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    {/* Breadcrumbs */}
    <nav class="text-[11px] uppercase tracking-wider text-stone-400 mb-6">
      <a href="/" class="hover:text-stone-800">Home</a> / <span class="text-stone-800">{cleanPageTitle}</span>
    </nav>

    {/* Page Title */}
    <div class="border-b border-stone-200 pb-6 mb-10">
      <h1 class="text-3xl sm:text-4xl text-stone-900 font-normal uppercase tracking-[0.15em]">
        {cleanPageTitle}
      </h1>
    </div>

    {/* WordPress HTML Content rendered cleanly */}
    <article
      class="prose prose-stone max-w-none prose-headings:font-normal prose-headings:tracking-wider prose-h2:text-xl prose-h3:text-lg prose-p:text-sm prose-p:leading-relaxed prose-p:text-stone-700 prose-li:text-sm prose-table:w-full prose-table:border-collapse prose-td:py-2 prose-td:border-b prose-td:border-stone-100"
      set:html={page.content.rendered}
    />
  </main>
</Layout>
