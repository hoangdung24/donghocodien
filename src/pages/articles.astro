---
import Layout from '@/layouts/Layout.astro';
import { Effect } from 'effect';
import { getPosts } from '@/lib/services/woocommerce';
import { cleanTitle } from '@/lib/utils/text';

export const prerender = true;

const url = Astro.url;
const page = Number(url.searchParams.get('page') || '1');

const postsResult = await Effect.runPromiseExit(getPosts({ per_page: 9, page }));
const posts = postsResult._tag === 'Success' ? postsResult.value : [];
const hasError = postsResult._tag === 'Failure';

function formatDate(dateStr: string) {
  return new Date(dateStr).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<Layout
  title='Articles & Horological Insights | Spacetime'
  description='Explore editorial articles, history, and collectors guides on authentic vintage timepieces.'
>
  <main class='mx-auto max-w-7xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8'>
    <nav class='mb-4 text-[11px] tracking-wider text-stone-400 uppercase'>
      <a href='/' class='hover:text-brand-dark'>
        Home
      </a>{' '}
      / <span class='text-brand-dark'>Articles</span>
    </nav>

    <div class='mb-12 border-b border-stone-200 pb-8'>
      <h1 class='mb-2 text-3xl font-normal tracking-[0.15em] uppercase sm:text-4xl'>
        Articles & Insights
      </h1>
      <p class='max-w-xl text-xs text-stone-500 sm:text-sm'>
        Curated stories and historical archives delving into vintage horology, legendary references,
        and provenance.
      </p>
    </div>

    {hasError && (
      <div class='mb-8 border border-red-200 bg-red-50 p-6 text-xs text-red-700'>
        Unable to load recent articles. Please refresh the page.
      </div>
    )}

    {posts.length > 0 && (
      <div class='grid grid-cols-1 gap-8 sm:gap-10 md:grid-cols-2 lg:grid-cols-3'>
        {posts.map((post) => {
          const title = cleanTitle(post.title.rendered);
          const image =
            post._embedded?.['wp:featuredmedia']?.[0]?.source_url || '/images/brand-story.jpg';
          const date = formatDate(post.date);

          return (
            <article class='group flex flex-col border border-stone-200 bg-white shadow-xs transition-shadow duration-300 hover:shadow-md'>
              <a
                href={`/${post.slug}`}
                class='relative block aspect-[16/10] overflow-hidden bg-stone-100'
              >
                <img
                  src={image}
                  alt={title}
                  class='h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105'
                  loading='lazy'
                />
              </a>

              <div class='flex flex-1 flex-col p-6'>
                <p class='mb-2 text-[10px] tracking-widest text-stone-400 uppercase'>{date}</p>

                <h2 class='mb-4 line-clamp-2 text-sm leading-relaxed font-medium tracking-wider uppercase'>
                  <a href={`/${post.slug}`} class='transition-colors hover:text-stone-500'>
                    {title}
                  </a>
                </h2>

                <div class='mt-auto border-t border-stone-100 pt-4'>
                  <a
                    href={`/${post.slug}`}
                    class='inline-block text-[10px] font-medium tracking-[0.2em] uppercase transition-colors hover:text-stone-500'
                  >
                    READ ARTICLE &rarr;
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    )}
  </main>
</Layout>
