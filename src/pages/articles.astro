---
import Layout from '../layouts/Layout.astro';
import { Effect } from 'effect';
import { getPosts } from '../lib/services/woocommerce';
import { cleanTitle } from '../lib/utils/text';

const url = Astro.url;
const page = Number(url.searchParams.get('page') || '1');

const postsResult = await Effect.runPromiseExit(getPosts({ per_page: 9, page }));
const posts = postsResult._tag === 'Success' ? postsResult.value : [];
const hasError = postsResult._tag === 'Failure';

function formatDate(dateStr: string) {
  return new Date(dateStr).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<Layout
  title='Articles & Horological Insights | Spacetime'
  description='Explore editorial articles, history, and collectors guides on authentic vintage timepieces.'
>
  <main class='max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16'>
    <nav class='text-[11px] uppercase tracking-wider text-stone-400 mb-4'>
      <a href='/' class='hover:text-black'>
        Home
      </a>{' '}
      / <span class='text-black'>Articles</span>
    </nav>

    <div class='border-b border-stone-200 pb-8 mb-12'>
      <h1 class='text-3xl sm:text-4xl text-black font-serif font-normal uppercase tracking-[0.15em] mb-2'>
        Articles & Insights
      </h1>
      <p class='text-xs sm:text-sm text-stone-500 max-w-xl'>
        Curated stories and historical archives delving into vintage horology, legendary references,
        and provenance.
      </p>
    </div>

    {hasError && (
      <div class='p-6 bg-red-50 border border-red-200 text-red-700 text-xs mb-8'>
        Unable to load recent articles. Please refresh the page.
      </div>
    )}

    {posts.length > 0 && (
      <div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 sm:gap-10'>
        {posts.map((post) => {
          const title = cleanTitle(post.title.rendered);
          const image =
            post._embedded?.['wp:featuredmedia']?.[0]?.source_url || '/images/brand-story.jpg';
          const date = formatDate(post.date);

          return (
            <article class='flex flex-col bg-white border border-stone-200 shadow-xs hover:shadow-md transition-shadow duration-300 group'>
              <a
                href={`/${post.slug}`}
                class='relative block aspect-[16/10] overflow-hidden bg-stone-100'
              >
                <img
                  src={image}
                  alt={title}
                  class='w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105'
                  loading='lazy'
                />
              </a>

              <div class='p-6 flex flex-col flex-1'>
                <p class='text-[10px] text-stone-400 uppercase tracking-widest mb-2'>{date}</p>

                <h2 class='text-sm font-serif font-medium text-black uppercase tracking-wider line-clamp-2 leading-relaxed mb-4'>
                  <a href={`/${post.slug}`} class='hover:text-stone-500 transition-colors'>
                    {title}
                  </a>
                </h2>

                <div class='mt-auto pt-4 border-t border-stone-100'>
                  <a
                    href={`/${post.slug}`}
                    class='inline-block text-[10px] uppercase tracking-[0.2em] font-medium text-black hover:text-stone-500 transition-colors'
                  >
                    READ ARTICLE &rarr;
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    )}
  </main>
</Layout>
