---
import Layout from '../layouts/Layout.astro';
import WatchCard from '../components/WatchCard.astro';
import { Effect } from 'effect';
import { getProducts, getCategories } from '../lib/services/woocommerce';

const url = Astro.url;
const page = Number(url.searchParams.get('page') || '1');
const search = url.searchParams.get('search') || undefined;

// Fetch products & categories in parallel with Effect.all
const program = Effect.all([
  getProducts({ page, per_page: 18, search }),
  getCategories(),
]);

const [productsResult, categoriesResult] = await Effect.runPromise(
  Effect.all([
    Effect.runPromiseExit(getProducts({ page, per_page: 18, search })),
    Effect.runPromiseExit(getCategories()),
  ])
);

const products = productsResult._tag === 'Success' ? productsResult.value : [];
const categories = categoriesResult._tag === 'Success' ? categoriesResult.value : [];

// Filter top brands for quick navigation
const topBrands = categories.filter((c) =>
  ['Omega', 'Rolex', 'Cartier', 'Seiko', 'Longines', 'Edox', 'Eterna', 'Zenith', 'Tissot'].some(
    (b) => c.name.toLowerCase() === b.toLowerCase()
  )
);
---

<Layout title="Bộ Sưu Tập Đồng Hồ Cổ Điển" description="Khám phá hơn 2.300+ mẫu đồng hồ cổ Thụy Sỹ & Nhật Bản nguyên bản.">
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    {/* Page Title */}
    <div class="border-b border-stone-200 pb-8 mb-8">
      <h1 class="font-serif text-3xl sm:text-5xl text-stone-900 font-normal mb-3">
        Bộ Sưu Tập Thời Gian
      </h1>
      <p class="text-sm text-stone-600 font-sans max-w-2xl">
        Tuyển tập các cỗ máy thời gian cổ điển đã được kiểm định độ nguyên bản, căn chỉnh sai số kỹ lưỡng trước khi đến tay nhà sưu tầm.
      </p>

      {/* Brand Filters */}
      {topBrands.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-6">
          <a
            href="/shop"
            class="px-3.5 py-1.5 text-xs uppercase tracking-wider border border-stone-900 bg-stone-900 text-white font-medium"
          >
            Tất cả
          </a>
          {topBrands.map((b) => (
            <a
              href={`/shop?category=${b.id}`}
              class="px-3.5 py-1.5 text-xs uppercase tracking-wider border border-stone-200 bg-white text-stone-700 hover:border-stone-900 transition-colors"
            >
              {b.name}
            </a>
          ))}
        </div>
      )}
    </div>

    {/* Products Grid */}
    {products.length === 0 ? (
      <div class="py-20 text-center font-serif text-stone-500">
        Không tìm thấy sản phẩm phù hợp.
      </div>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {products.map((watch) => (
          <WatchCard product={watch} />
        ))}
      </div>
    )}

    {/* Pagination */}
    <div class="mt-16 pt-8 border-t border-stone-200 flex items-center justify-between">
      {page > 1 ? (
        <a
          href={`/shop?page=${page - 1}${search ? `&search=${search}` : ''}`}
          class="px-5 py-2.5 border border-stone-300 text-xs uppercase tracking-widest font-serif text-stone-800 hover:bg-stone-100 transition-colors"
        >
          &larr; Trang trước
        </a>
      ) : <div />}

      <span class="text-xs uppercase tracking-widest text-stone-500 font-sans">
        Trang {page}
      </span>

      <a
        href={`/shop?page=${page + 1}${search ? `&search=${search}` : ''}`}
        class="px-5 py-2.5 border border-stone-300 text-xs uppercase tracking-widest font-serif text-stone-800 hover:bg-stone-100 transition-colors"
      >
        Trang tiếp &rarr;
      </a>
    </div>
  </main>
</Layout>
