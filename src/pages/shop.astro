---
import Layout from '../layouts/Layout.astro';
import CatalogView from '../components/CatalogView.astro';
import { Effect } from 'effect';
import { getAllProducts, getCategories } from '../lib/services/woocommerce';
import { filterCatalog } from '../lib/utils/catalog';
import { parseSearchQuery } from '../lib/utils/search';

export const prerender = true;

const PAGE_SIZE = 20;
const BASE_PATH = '/shop';

const url = Astro.url;
const page = Math.max(1, Number(url.searchParams.get('page') || '1') || 1);
const search = parseSearchQuery(url.searchParams);

const [catalog, categories] = await Effect.runPromise(
  Effect.all([getAllProducts, getCategories], { concurrency: 'unbounded' })
);

const products = filterCatalog(catalog, categories, { page, search, categories }, PAGE_SIZE);

const pageTitle = search ? `Shop results for "${search}"` : 'Shop All Watches';
---

<Layout
  title={`${pageTitle} | Spacetime`}
  description='Shop authentic vintage Swiss and Japanese timepieces from the Spacetime collection.'
>
  <main class='mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8'>
    <header class='mb-8 border-b border-stone-200 pb-8'>
      <h1 class='text-2xl leading-tight font-normal tracking-wide sm:text-3xl'>{pageTitle}</h1>
    </header>
    <div class='mb-8 pb-8'>
      <CatalogView
        products={products}
        categories={categories}
        availableProducts={catalog}
        activeCategory={null}
        search={search}
        page={page}
        pageSize={PAGE_SIZE}
        basePath={BASE_PATH}
      />
    </div>
  </main>
</Layout>
