---
import Layout from '../layouts/Layout.astro';
import WatchCard from '../components/WatchCard.astro';
import { Effect } from 'effect';
import { getProducts, getCategories } from '../lib/services/woocommerce';

const url = Astro.url;
const page = Number(url.searchParams.get('page') || '1');
const search = url.searchParams.get('search') || undefined;

// Fetch products & categories in parallel
const [productsResult, categoriesResult] = await Effect.runPromise(
  Effect.all([
    Effect.runPromiseExit(getProducts({ page, per_page: 20, search })),
    Effect.runPromiseExit(getCategories),
  ])
);

const products = productsResult._tag === 'Success' ? productsResult.value : [];
const categories = categoriesResult._tag === 'Success' ? categoriesResult.value : [];

// Filter key brands
const topBrands = categories.filter((c) =>
  ['Omega', 'Rolex', 'Cartier', 'Seiko', 'Longines', 'Edox', 'Eterna', 'Zenith', 'Tissot', 'Universal Geneve'].some(
    (b) => c.name.toLowerCase() === b.toLowerCase()
  )
);
---

<Layout title="All Watches - Timepiece Archive | Spacetime" description="Explore over 2,300+ vintage timepieces from Switzerland and Japan.">
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    {/* Page Title & Breadcrumb */}
    <div class="border-b border-stone-200 pb-8 mb-8">
      <nav class="text-[11px] uppercase tracking-wider text-stone-400 mb-2">
        <a href="/" class="hover:text-stone-800">Home</a> / <span class="text-stone-800">Watches</span>
      </nav>

      <h1 class="text-2xl sm:text-4xl text-stone-900 font-normal uppercase tracking-[0.15em] mb-2">
        Watches
      </h1>
      <p class="text-xs text-stone-500 max-w-xl">
        Every timepiece is authenticated, regulated, and verified before acquisition.
      </p>

      {/* Brand Filters */}
      {topBrands.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-6">
          <a
            href="/shop"
            class="px-3 py-1.5 text-[11px] uppercase tracking-wider border border-[#191414] bg-[#191414] text-white font-medium"
          >
            All
          </a>
          {topBrands.map((b) => (
            <a
              href={`/shop?category=${b.id}`}
              class="px-3 py-1.5 text-[11px] uppercase tracking-wider border border-stone-200 bg-white text-stone-700 hover:border-stone-900 transition-colors"
            >
              {b.name}
            </a>
          ))}
        </div>
      )}
    </div>

    {/* Responsive 4-Column Grid */}
    {products.length === 0 ? (
      <div class="py-24 text-center text-xs uppercase tracking-widest text-stone-400">
        No timepieces found matching this criteria.
      </div>
    ) : (
      <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6 lg:gap-8">
        {products.map((watch) => (
          <WatchCard product={watch} />
        ))}
      </div>
    )}

    {/* Pagination */}
    <div class="mt-16 pt-8 border-t border-stone-200 flex items-center justify-between">
      {page > 1 ? (
        <a
          href={`/shop?page=${page - 1}${search ? `&search=${search}` : ''}`}
          class="px-5 py-2.5 border border-stone-300 text-xs uppercase tracking-widest text-stone-800 hover:bg-stone-100 transition-colors"
        >
          &larr; Previous
        </a>
      ) : <div />}

      <span class="text-xs uppercase tracking-widest text-stone-500 font-sans">
        Page {page}
      </span>

      <a
        href={`/shop?page=${page + 1}${search ? `&search=${search}` : ''}`}
        class="px-5 py-2.5 border border-stone-300 text-xs uppercase tracking-widest text-stone-800 hover:bg-stone-100 transition-colors"
      >
        Next &rarr;
      </a>
    </div>
  </main>
</Layout>
