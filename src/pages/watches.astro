---
import CatalogPage from '@/components/CatalogPage.astro';
import { Effect } from 'effect';
import { getAllProducts, getCategories } from '@/lib/services/woocommerce';
import { filterCatalog } from '@/lib/utils/catalog';

export const prerender = true;

const PAGE_SIZE = 20;

const [catalog, categories] = await Effect.runPromise(
  Effect.all([getAllProducts, getCategories], { concurrency: 'unbounded' })
);

const products = filterCatalog(catalog, categories, { page: 1, categories }, PAGE_SIZE);
---

<CatalogPage
  products={products}
  categories={categories}
  availableProducts={catalog}
  activeCategory={null}
  page={1}
  pageSize={PAGE_SIZE}
  basePath='/watches'
/>
