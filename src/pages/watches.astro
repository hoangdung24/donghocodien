---
import CatalogView from '@/components/CatalogView.astro';
import Layout from '@/layouts/Layout.astro';
import { Effect } from 'effect';
import type { ProductCategory } from '@/lib/schema/product';
import { getCatalogSummary, getCategories, getProductsPage } from '@/lib/services/woocommerce';
import { categoryIdFromParam } from '@/lib/utils/categories';
import { descendantCategoryIds } from '@/lib/utils/catalog';
import { parseSearchQuery } from '@/lib/utils/search';
import { cleanTitle } from '@/lib/utils/text';

export const prerender = false;

const PAGE_SIZE = 20;

const url = Astro.url;
const requestedPage = Math.max(1, Number(url.searchParams.get('page') || '1') || 1);
const search = parseSearchQuery(url.searchParams);
const rawCategory = url.searchParams.get('category') ?? undefined;
const minPriceParam = url.searchParams.get('min_price');
const maxPriceParam = url.searchParams.get('max_price');
const parsedMinPrice = minPriceParam !== null ? Number(minPriceParam) : NaN;
const parsedMaxPrice = maxPriceParam !== null ? Number(maxPriceParam) : NaN;
const hasPriceFilter = !Number.isNaN(parsedMinPrice) && !Number.isNaN(parsedMaxPrice);

const [categoriesResult, summaryResult] = await Effect.runPromise(
  Effect.all([Effect.exit(getCategories), Effect.exit(getCatalogSummary)], {
    concurrency: 'unbounded',
  })
);

const categories = categoriesResult._tag === 'Success' ? categoriesResult.value : [];
const summary = summaryResult._tag === 'Success' ? summaryResult.value : null;

const categoryId = categoryIdFromParam(rawCategory, categories);
const activeCategory: ProductCategory | null = categoryId
  ? (categories.find((category) => category.id === categoryId) ?? null)
  : null;

const selectedCategoryIds = categoryId
  ? (() => {
      const descendants = descendantCategoryIds(categories, categoryId);
      return descendants.length > 0 ? descendants : [categoryId];
    })()
  : undefined;

const productsResult = await Effect.runPromise(
  Effect.exit(
    getProductsPage({
      page: requestedPage,
      per_page: PAGE_SIZE,
      search,
      category: selectedCategoryIds,
      min_price: hasPriceFilter ? parsedMinPrice : undefined,
      max_price: hasPriceFilter ? parsedMaxPrice : undefined,
      stock_status: 'instock',
      orderby: 'price',
      order: 'desc',
    })
  )
);

const products =
  productsResult._tag === 'Success'
    ? productsResult.value.products.filter(
        (product) => product.is_in_stock && Number(product.prices.price) > 0
      )
    : [];
const totalPages = productsResult._tag === 'Success' ? productsResult.value.totalPages : 1;

const hasUncacheableData =
  categoriesResult._tag === 'Failure' ||
  summaryResult._tag === 'Failure' ||
  productsResult._tag === 'Failure';
if (hasUncacheableData) {
  Astro.cache.set(false);
}

const pageTitle = activeCategory
  ? `${cleanTitle(activeCategory.name)} Watches`
  : search
    ? `Search Results for "${search}"`
    : 'All Watches';

const priceBounds = summary
  ? { minPrice: summary.minPrice, maxPrice: summary.maxPrice }
  : undefined;
---

<Layout
  title={`${pageTitle} | Spacetime`}
  description='Explore over 2,300+ vintage timepieces from Switzerland and Japan.'
>
  <main class='mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8'>
    <h1 class='sr-only'>{pageTitle}</h1>
    <div class='mb-8 pb-8'>
      <CatalogView
        products={products}
        categories={categories}
        availableProducts={[]}
        availableCategoryCounts={summary?.countsByCategory}
        priceBounds={priceBounds}
        activeCategory={activeCategory}
        search={search}
        page={requestedPage}
        hasNextPage={totalPages > requestedPage}
        basePath='/watches'
        hasPriceFilter={hasPriceFilter}
        minPriceFilter={hasPriceFilter ? parsedMinPrice : undefined}
        maxPriceFilter={hasPriceFilter ? parsedMaxPrice : undefined}
      />
    </div>
  </main>
</Layout>
