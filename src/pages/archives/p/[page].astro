---
import ArchivePage from '@/components/ArchivePage.astro';
import { Effect } from 'effect';
import { getBrandCategories, getCategories, getProductsPage } from '@/lib/services/woocommerce';
import { categoryIdFromParam } from '@/lib/utils/categories';
import { descendantCategoryIds } from '@/lib/utils/catalog';
import { parseSearchQuery } from '@/lib/utils/search';

export const prerender = false;

const PAGE_SIZE = 20;

const url = Astro.url;
const requestedPage = Math.max(1, Number(Astro.params.page || '2') || 2);
const search = parseSearchQuery(url.searchParams);
const rawCategory = url.searchParams.get('category') ?? undefined;

const [categoriesResult] = await Effect.runPromise(
  Effect.all([Effect.exit(getCategories), Effect.exit(getBrandCategories)], {
    concurrency: 'unbounded',
  })
);

const categories = categoriesResult._tag === 'Success' ? categoriesResult.value : [];
const activeCategoryId = categoryIdFromParam(rawCategory, categories);

const descendants = activeCategoryId ? descendantCategoryIds(categories, activeCategoryId) : [];
const selectedCategoryIds = activeCategoryId
  ? descendants.length > 0
    ? descendants
    : [activeCategoryId]
  : undefined;

const productsResult = await Effect.runPromise(
  Effect.exit(
    getProductsPage({
      page: requestedPage,
      per_page: PAGE_SIZE,
      search,
      category: selectedCategoryIds,
      orderby: 'price',
      order: 'asc',
      stock_status: 'outofstock',
    })
  )
);

const fetchedProducts = productsResult._tag === 'Success' ? productsResult.value.products : [];
const products = fetchedProducts.filter((product) => !product.is_in_stock);
---

<ArchivePage
  products={products}
  categories={categories}
  activeCategoryId={activeCategoryId}
  search={search}
  requestedPage={requestedPage}
  hasNextPage={productsResult._tag === 'Success' && productsResult.value.totalPages > requestedPage}
/>
