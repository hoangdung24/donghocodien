---
import ArchivePage from '@/components/ArchivePage.astro';
import { loadArchivePage } from '@/lib/services/archive';
import { parseSearchQuery } from '@/lib/utils/search';

export const prerender = false;

const url = Astro.url;
const search = parseSearchQuery(url.searchParams);
const rawCategory = url.searchParams.get('category') ?? undefined;

const { products, categories, activeCategoryId, hasNextPage } = await loadArchivePage({
  page: 1,
  search,
  rawCategory,
});

if (products.length === 0) {
  Astro.cache.set(false);
}
---

<ArchivePage
  products={products}
  categories={categories}
  activeCategoryId={activeCategoryId}
  search={search}
  requestedPage={1}
  hasNextPage={hasNextPage}
/>
