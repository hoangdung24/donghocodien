---
import ArchivePage from '@/components/ArchivePage.astro';
import { loadArchivePage } from '@/lib/services/archive';
import { parseSearchQuery } from '@/lib/utils/search';
import { pageCacheControl, resolveCacheScope } from '@/lib/utils/cachePolicy';
import { readRequestCountry, resolveApproxPricingVisibility } from '@/lib/utils/visual';

export const prerender = false;

const url = Astro.url;
const search = parseSearchQuery(url.searchParams);
const rawCategory = url.searchParams.get('category') ?? undefined;

const { products, categories, activeCategoryId, hasNextPage } = await loadArchivePage({
  page: 1,
  search,
  rawCategory,
});

const approximatePricing = resolveApproxPricingVisibility(
  readRequestCountry(Astro.request.headers.get('cookie'))
);

Astro.response.headers.set(
  'Cache-Control',
  pageCacheControl(resolveCacheScope(url.pathname), products.length > 0)
);
---

<ArchivePage
  products={products}
  categories={categories}
  activeCategoryId={activeCategoryId}
  search={search}
  requestedPage={1}
  hasNextPage={hasNextPage}
  approximatePricing={approximatePricing}
/>
