---
import Layout from '@/layouts/Layout.astro';
import { Effect } from 'effect';
import { getPageBySlug } from '@/lib/services/woocommerce';
import { demoteEmbeddedHeadings, sanitizeWordPressHtml } from '@/lib/utils/html';
import { cleanTitle } from '@/lib/utils/text';
import { POLICY_CONTENT, POLICY_TITLES } from '@/lib/data/policyContent';

export const prerender = true;

const pageResult = await Effect.runPromiseExit(getPageBySlug('payment-shipping-methods'));

const page =
  pageResult._tag === 'Success'
    ? pageResult.value
    : {
        title: { rendered: POLICY_TITLES['payment-shipping-methods'] },
        content: { rendered: POLICY_CONTENT['payment-shipping-methods'] },
      };

const cleanPageTitle = cleanTitle(page.title.rendered);
const sanitizedHtmlContent = await sanitizeWordPressHtml(page.content.rendered);
const cleanHtmlContent = await demoteEmbeddedHeadings(sanitizedHtmlContent);
---

<Layout
  title={`${cleanPageTitle} | Spacetime`}
  description={`${cleanPageTitle} — Spacetime Vintage Watch Atelier`}
>
  <main class='mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8'>
    <h1 class='mb-8 text-2xl leading-tight font-normal tracking-wide text-brand-dark sm:text-3xl'>
      {cleanPageTitle}
    </h1>
    <article
      class='prose max-w-none prose-stone prose-headings:font-normal prose-headings:tracking-wide prose-h2:text-2xl prose-h3:text-xl prose-p:text-sm prose-p:leading-relaxed prose-p:text-stone-700 sm:prose-p:text-base prose-table:w-full prose-table:border-collapse prose-td:border-b prose-td:border-stone-100 prose-td:py-2.5 prose-img:rounded-none prose-img:shadow-sm'
      set:html={cleanHtmlContent}
    />
  </main>
</Layout>
