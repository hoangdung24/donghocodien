---
import Layout from '../layouts/Layout.astro';
import { ConsignmentForm } from '../components/ConsignmentForm';
import { MessageCircle, Phone, ShieldCheck, Clock, Award } from 'lucide-react';
---

<Layout
  title="Consign Your Watch | Spacetime - Vintage Watch"
  description="Consign your luxury vintage timepiece with Spacetime. We accept Rolex, Cartier, Patek Philippe, Audemars Piguet, and vintage horology with worldwide collector reach."
>
  <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    {/* Breadcrumbs */}
    <nav class="text-[11px] uppercase tracking-wider text-stone-400 mb-6 font-sans">
      <a href="/" class="hover:text-stone-800 transition-colors">Home</a> / 
      <span class="text-stone-800 font-medium">Consign Your Watch</span>
    </nav>

    {/* Header */}
    <div class="border-b border-stone-200 pb-8 mb-12">
      <p class="text-xs uppercase tracking-[0.25em] text-stone-400 font-medium mb-2">
        Boutique Curatorial Services &bull; Spacetime
      </p>
      <h1 class="text-3xl sm:text-5xl text-stone-900 font-normal tracking-tight uppercase font-heading">
        Consign Your Watch
      </h1>
      <p class="text-sm text-stone-600 max-w-2xl leading-relaxed mt-3">
        Entrust your rare, vintage, or collectible timepiece to our atelier for global collector placement, transparent valuation, and professional mechanical verification.
      </p>
    </div>

    {/* Two-Column Grid */}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      {/* Left Column: Context, Boutique Image & Direct Contacts (5 cols) */}
      <div class="lg:col-span-5 space-y-8">
        <div>
          <h2 class="text-xl sm:text-2xl font-serif text-stone-900 tracking-wide uppercase mb-4">
            We Accept Consignments
          </h2>
          <div class="text-xs text-stone-700 leading-relaxed space-y-3">
            <p>
              At Spacetime, we specialize in pre-owned luxury timepieces from prestigious maisons such as <strong class="text-stone-950">Rolex, Cartier, Patek Philippe, Audemars Piguet, Omega, Jaeger-LeCoultre</strong>, and more.
            </p>
            <p>
              If you own a classic watch from one of these manufacturers, feel free to fill out our consignment form or contact us directly via <strong class="text-stone-950">iMessage or WhatsApp</strong>.
            </p>
          </div>
        </div>

        {/* Boutique Image */}
        <div class="overflow-hidden bg-stone-100 border border-stone-200 shadow-xs">
          <img
            src="/images/consign-banner.jpg"
            alt="Spacetime Boutique Atelier Showcase"
            class="w-full h-auto object-cover"
            loading="eager"
          />
        </div>

        <div class="text-xs text-stone-600 leading-relaxed bg-stone-50 border border-stone-200 p-5 space-y-2">
          <p class="font-medium text-stone-900 flex items-center gap-2">
            <Clock class="w-4 h-4 text-stone-700" />
            24-Hour Valuation Response
          </p>
          <p>
            We aim to evaluate your inquiry and respond within <strong class="text-stone-900">24 hours</strong>. You are also warmly invited to visit our boutique atelier in Ho Chi Minh City by appointment to discuss terms in person.
          </p>
        </div>

        {/* Reassurance Highlights */}
        <div class="space-y-3 pt-2">
          <div class="flex items-start gap-3">
            <ShieldCheck class="w-4 h-4 text-emerald-800 mt-0.5 flex-shrink-0" />
            <div>
              <p class="text-xs uppercase tracking-wider font-semibold text-stone-900">
                100% Insured Escrow &amp; Logistics
              </p>
              <p class="text-xs text-stone-500 mt-0.5">
                Every timepiece is covered from initial intake through final collector delivery.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <Award class="w-4 h-4 text-emerald-800 mt-0.5 flex-shrink-0" />
            <div>
              <p class="text-xs uppercase tracking-wider font-semibold text-stone-900">
                Master Watchmaker Inspection
              </p>
              <p class="text-xs text-stone-500 mt-0.5">
                Full mechanical testing, timing calibration, and authentic component verification.
              </p>
            </div>
          </div>
        </div>

        {/* Direct Contacts */}
        <div class="pt-4 border-t border-stone-200 space-y-3">
          <p class="text-xs uppercase tracking-widest text-stone-400 font-medium">
            Immediate Assistance
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <a
              href="https://wa.me/84941625653"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-3 p-3 border border-stone-200 hover:border-emerald-700 bg-white hover:bg-emerald-50/20 transition-all text-xs text-stone-800 font-medium"
            >
              <MessageCircle class="w-4 h-4 text-emerald-700 flex-shrink-0" />
              <span>WhatsApp Concierge</span>
            </a>
            <a
              href="tel:+84941625653"
              class="flex items-center gap-3 p-3 border border-stone-200 hover:border-stone-900 bg-white hover:bg-stone-50 transition-all text-xs text-stone-800 font-medium font-mono"
            >
              <Phone class="w-4 h-4 text-stone-700 flex-shrink-0" />
              <span>+84 94 162 5653</span>
            </a>
          </div>
        </div>
      </div>

      {/* Right Column: Luxury Consignment Submission Form (7 cols) */}
      <div class="lg:col-span-7 bg-white border border-stone-200 p-6 sm:p-10 shadow-xs">
        <div class="border-b border-stone-200 pb-5 mb-8">
          <h2 class="text-lg font-serif uppercase tracking-wider text-stone-900 mb-1">
            Timepiece Consignment Form
          </h2>
          <p class="text-xs text-stone-500">
            Please provide details and condition photos of your watch. Fields marked with an asterisk (*) are required.
          </p>
        </div>

        <ConsignmentForm client:load />
      </div>
    </div>
  </main>
</Layout>
