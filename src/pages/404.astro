---
import Layout from '@/layouts/Layout.astro';
import { WatchCard } from '@/components/WatchCard';
import { Effect } from 'effect';
import { getCategories, getProducts } from '@/lib/services/woocommerce';
import { CONTACT, SITE } from '@/lib/constants';

const [productsResult, categoriesResult] = await Promise.all([
  Effect.runPromiseExit(getProducts({ per_page: 8 })),
  Effect.runPromiseExit(getCategories),
]);
const categories = categoriesResult._tag === 'Success' ? categoriesResult.value : [];
const availableWatches =
  productsResult._tag === 'Success'
    ? productsResult.value
        .filter((product) => product.is_in_stock && Number(product.prices.price) > 0)
        .slice(0, 4)
    : [];

Astro.response.status = 404;
---

<Layout
  title='Page Not Found – Spacetime'
  description='The timepiece or page you are looking for has moved, sold, or never existed. Browse our vintage watch collection instead.'
>
  <main class='mx-auto max-w-7xl px-4 pt-16 pb-20 sm:px-6 sm:pt-24 lg:px-8'>
    <div class='mx-auto max-w-2xl text-center'>
      <p class='text-[11px] font-medium tracking-[0.32em] text-stone-400 uppercase'>
        404 &mdash; Path Not Found
      </p>

      <h1 class='mt-6 text-3xl leading-tight font-normal tracking-[0.12em] text-brand-dark uppercase sm:text-5xl'>
        This Watch Has Left The Display
      </h1>

      <p class='mx-auto mt-6 max-w-lg text-sm leading-relaxed sm:text-base'>
        The page you are looking for has been moved, sold to another collector, or never existed.
        Every {SITE.name} timepiece is one of a kind — but the archive is never empty.
      </p>

      <div class='mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row'>
        <a
          href='/watches'
          class='w-full border border-black bg-black px-10 py-3.5 text-xs font-medium tracking-[0.2em] text-white uppercase transition-colors hover:bg-stone-800 sm:w-auto'
        >
          Browse The Collection
        </a>
        <a
          href='/'
          class='w-full border border-stone-300 px-10 py-3.5 text-xs font-medium tracking-[0.2em] text-stone-800 uppercase transition-colors hover:border-black hover:bg-stone-50 sm:w-auto'
        >
          Back To Home
        </a>
      </div>
    </div>

    {availableWatches.length > 0 && (
      <section class='mt-20 border-t border-stone-200 pt-12'>
        <div class='mb-8 text-center sm:mb-10'>
          <h2 class='text-lg font-normal tracking-[0.2em] uppercase sm:text-2xl'>
            <a href='/watches' class='transition-colors hover:text-stone-500'>
              Recently Available
            </a>
          </h2>
          <p class='mt-2 text-xs text-stone-500 italic sm:text-sm'>
            Timepieces currently in the {SITE.name} vault
          </p>
        </div>

        <div class='grid grid-cols-2 gap-4 sm:gap-6 md:grid-cols-3 lg:grid-cols-4 lg:gap-8'>
          {availableWatches.map((watch) => (
            <WatchCard
              client:visible
              product={watch}
              categories={categories}
              country={Astro.locals.country}
            />
          ))}
        </div>
      </section>
    )}
  </main>
</Layout>
