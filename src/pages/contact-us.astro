---
import Layout from '@/layouts/Layout.astro';
import { Mail, MessageCircle, Phone, MapPin } from '@lucide/astro';
import { ContactForm } from '@/components/ContactForm';
import { CONTACT, SITE } from '@/lib/constants';

export const prerender = true;
---

<Layout
  title='Contact Us - Boutique Concierge'
  description='Connect with our horology specialists in Ho Chi Minh City or via WhatsApp for acquisitions and valuations.'
>
  <main class='mx-auto max-w-5xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8'>
    <nav aria-label='Breadcrumb' class='mb-6 text-[11px] tracking-wider text-stone-600 uppercase'>
      <a href='/' class='hover:text-brand-dark'>
        Home
      </a>
      <span aria-hidden='true'> / </span>
      <span class='text-brand-dark' aria-current='page'>
        Contact Us
      </span>
    </nav>

    <div class='mb-12 border-b border-stone-200 pb-8'>
      <p class='mb-2 text-xs font-medium tracking-[0.25em] text-stone-500 uppercase'>
        Boutique Concierge &bull; {SITE.name}
      </p>
      <h1 class='mb-4 text-3xl font-normal tracking-tight sm:text-5xl'>Contact Our Specialists</h1>
      <p class='max-w-2xl text-sm leading-relaxed text-stone-600'>
        Whether you are seeking a specific vintage reference or inquiring about timepiece
        authentication, our team is at your disposal worldwide.
      </p>
    </div>

    <div class='grid grid-cols-1 items-start gap-12 md:grid-cols-2'>
      <div class='flex flex-col gap-8'>
        <section aria-labelledby='contact-channels-heading'>
          <h2
            id='contact-channels-heading'
            class='mb-6 text-xs font-bold tracking-[0.2em] uppercase'
          >
            Direct Communication Channels
          </h2>

          <div class='flex flex-col gap-4'>
            <a
              href={CONTACT.whatsappLink}
              target='_blank'
              rel='noopener noreferrer'
              class='group flex items-center gap-4 border border-stone-200 bg-white p-4 transition-all hover:border-black hover:bg-stone-50/30'
            >
              <div
                aria-hidden='true'
                class='flex h-12 w-12 shrink-0 items-center justify-center bg-stone-100/70 text-stone-800 transition-colors group-hover:bg-black group-hover:text-white'
              >
                <MessageCircle class='h-6 w-6' />
              </div>
              <div class='min-w-0 flex-1'>
                <p class='text-xs font-semibold tracking-wider uppercase'>WhatsApp Concierge</p>
                <p class='mt-0.5 font-mono text-xs text-stone-600'>{CONTACT.whatsapp}</p>
              </div>
              <span
                aria-hidden='true'
                class='text-xs font-medium tracking-wider text-stone-800 uppercase'
              >
                Chat &rarr;
              </span>
            </a>

            <a
              href={CONTACT.emailLink}
              class='group flex items-center gap-4 border border-stone-200 bg-white p-4 transition-all hover:border-black hover:bg-stone-50'
            >
              <div
                aria-hidden='true'
                class='flex h-12 w-12 shrink-0 items-center justify-center bg-stone-100 text-stone-800 transition-colors group-hover:bg-black group-hover:text-white'
              >
                <Mail class='h-6 w-6' />
              </div>
              <div class='min-w-0 flex-1'>
                <p class='text-xs font-semibold tracking-wider uppercase'>Email Inquiries</p>
                <p class='mt-0.5 truncate text-xs text-stone-600'>{CONTACT.email}</p>
              </div>
              <span aria-hidden='true' class='text-xs font-medium tracking-wider uppercase'>
                Write &rarr;
              </span>
            </a>

            <a
              href={CONTACT.phoneLink}
              class='group flex items-center gap-4 border border-stone-200 bg-white p-4 transition-all hover:border-black hover:bg-stone-50'
            >
              <div
                aria-hidden='true'
                class='flex h-12 w-12 shrink-0 items-center justify-center bg-stone-100 text-stone-800 transition-colors group-hover:bg-black group-hover:text-white'
              >
                <Phone class='h-6 w-6' />
              </div>
              <div class='min-w-0 flex-1'>
                <p class='text-xs font-semibold tracking-wider uppercase'>Direct Line</p>
                <p class='mt-0.5 font-mono text-xs text-stone-600'>{CONTACT.whatsapp}</p>
              </div>
            </a>
          </div>
        </section>

        <div class='flex flex-col gap-4 border border-stone-200 bg-stone-100 p-6'>
          <div class='flex items-start gap-3'>
            <MapPin class='mt-0.5 h-5 w-5 shrink-0 text-stone-700' aria-hidden='true' />
            <div>
              <p class='text-xs font-bold tracking-wider uppercase'>Atelier Location</p>
              <p class='mt-1 text-xs leading-relaxed text-stone-600'>
                {CONTACT.location} (Private viewing available by prior appointment).
              </p>
            </div>
          </div>
        </div>
      </div>

      <section
        aria-labelledby='contact-form-heading'
        class='border border-stone-200 bg-white p-8 shadow-xs'
      >
        <h2 id='contact-form-heading' class='mb-2 text-xs font-bold tracking-[0.2em] uppercase'>
          Send an Inquiry
        </h2>
        <p class='mb-6 text-xs text-stone-600'>
          We respond to all collector inquiries within 12 hours. Fields marked with an asterisk are
          required.
        </p>

        <ContactForm client:load />
      </section>
    </div>
  </main>
</Layout>
