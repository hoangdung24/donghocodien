---
import { Effect } from 'effect';
import HeroCarousel from '../components/HeroCarousel';
import ProductCarousel from '../components/ProductCarousel';
import Layout from '../layouts/Layout.astro';
import { SEO, SITE } from '../lib/constants';
import { getProducts } from '../lib/services/woocommerce';

export const prerender = true;

const productsResult = await Effect.runPromiseExit(getProducts({ per_page: 12 }));

const products = productsResult._tag === 'Success' ? productsResult.value : [];
const hasProductError = productsResult._tag === 'Failure';
---

<Layout title={SEO.defaultTitle} description={SEO.defaultDescription}>
  <section class='relative w-full'>
    <HeroCarousel client:load />
  </section>

  <section class='bg-white py-16 lg:py-24'>
    <div class='mx-auto max-w-7xl px-4 sm:px-6 lg:px-8'>
      <div class='grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-16'>
        <div class='flex flex-col gap-6 lg:col-span-7'>
          <h2 class='text-lg leading-snug tracking-[0.12em] uppercase sm:text-2xl lg:text-3xl'>
            SPACETIME – A MISSION TO BRING ELEGANCE TO MILLIONS OF WRISTS
          </h2>

          <div class='flex flex-col gap-4 font-sans text-xs leading-relaxed font-light text-stone-600 sm:text-sm'>
            <p>
              Vintage watches have long left deep imprints across time — marking decades, even
              centuries — evoking memories of a bygone era. Born with the mission to deliver
              timeless elegance to every wrist, {SITE.name} represents two precious moments we all
              hold dear: “Now and Here.” With each passing second, we’re reminded to live fully in
              the present — no matter the time, no matter the place.
            </p>
            <p>
              From wandering the world to expressing your unique style, wherever you are and
              whatever you do, {SITE.name} is always with you — here, now, and on your wrist.
            </p>
          </div>

          <div class='pt-2'>
            <a
              href='/about-us'
              class='inline-block border-b border-black pb-1 text-xs font-medium tracking-[0.2em] uppercase transition-colors hover:border-stone-500 hover:text-stone-500'
            >
              READ MORE &lt;&lt;
            </a>
          </div>
        </div>

        <div class='flex justify-center lg:col-span-5'>
          <div class='group relative aspect-4/5 w-full max-w-md overflow-hidden shadow-xl'>
            <img
              src='/images/brand-story.jpg'
              alt={`${SITE.name} Vintage Timepiece on Leather`}
              class='h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105'
              loading='lazy'
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class='bg-white py-16 lg:py-24'>
    <div class='mx-auto max-w-7xl px-4 sm:px-6 lg:px-8'>
      <div class='mb-8 text-center sm:mb-12'>
        <h2 class='text-xl font-normal tracking-[0.2em] uppercase sm:text-2xl lg:text-3xl'>
          <a href='/watches' class='transition-colors hover:text-stone-500'>
            SHOP NOW
          </a>
        </h2>
        <p class='mt-2 text-xs text-stone-500 italic sm:text-sm'>Come visit our online store</p>
      </div>

      {hasProductError && (
        <div class='mx-auto max-w-lg border border-red-200 bg-red-50 p-6 text-center text-xs text-red-700'>
          Temporary latency connecting to WooCommerce API. Please refresh the page.
        </div>
      )}

      {products.length > 0 && <ProductCarousel client:visible products={products} />}

      <div class='mt-14 text-center'>
        <a
          href='/watches'
          class='inline-block border border-black px-10 py-3.5 text-xs font-medium tracking-[0.2em] uppercase transition-colors hover:bg-stone-900 hover:text-white'
        >
          Discover All 2,300+ Watches &rarr;
        </a>
      </div>
    </div>
  </section>
</Layout>
