---
import Layout from '../layouts/Layout.astro';
import HeroCarousel from '../components/HeroCarousel';
import ProductCarousel from '../components/ProductCarousel';
import { Effect } from 'effect';
import { getProducts, getPosts } from '../lib/services/woocommerce';

const [productsResult, postsResult] = await Effect.runPromise(
  Effect.all([
    Effect.exit(getProducts({ per_page: 12 })),
    Effect.exit(getPosts({ per_page: 3 })),
  ])
);

const products = productsResult._tag === 'Success' ? productsResult.value : [];
const livePosts = postsResult._tag === 'Success' ? postsResult.value : [];
const hasProductError = productsResult._tag === 'Failure';

function cleanTitle(title: string) {
  return title
    .replace(/&#8216;/g, '‘')
    .replace(/&#8217;/g, '’')
    .replace(/&#8220;/g, '“')
    .replace(/&#8221;/g, '”')
    .replace(/&#8211;/g, '–')
    .replace(/&#038;/g, '&')
    .replace(/&amp;/g, '&');
}

function formatDate(dateStr: string) {
  return new Date(dateStr).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).toUpperCase();
}

const fallbackArticles = [
  {
    title: '“LES MUST DE CARTIER!” – ORIGIN & POWER',
    href: '/les-must-de-cartier-nguon-goc-suc-manh',
    date: 'DECEMBER 27, 2021',
    image: '/images/articles/article-cartier.jpg',
    alt: 'Les Must de Cartier Vintage Timepiece',
  },
  {
    title: 'JLC REVERSO – ORIGIN AND HISTORY OF EXISTENCE',
    href: '/jlc-reverso-nguon-goc-va-lich-su-ton-tai',
    date: 'NOVEMBER 22, 2021',
    image: '/images/articles/article-reverso.jpg',
    alt: 'Jaeger-LeCoultre Reverso Vintage Watch',
  },
  {
    title: 'WHY YOU SHOULD LOVE VINTAGE WATCHES',
    href: '/tai-sao-ban-nen-mua-dong-ho-co-dien',
    date: 'NOVEMBER 19, 2021',
    image: '/images/articles/article-why-vintage.jpg',
    alt: 'Vintage Mechanical Watch Movement and Patina',
  },
];

const articles = livePosts.length > 0
  ? livePosts.map((post, idx) => ({
      title: cleanTitle(post.title.rendered),
      href: `/${post.slug}`,
      date: formatDate(post.date),
      image: post._embedded?.['wp:featuredmedia']?.[0]?.source_url || fallbackArticles[idx]?.image || '/images/brand-story.jpg',
      alt: cleanTitle(post.title.rendered),
    }))
  : fallbackArticles;
---

<Layout
  title="Spacetime - Vintage Watch | Authentic Swiss & Japanese Timepieces"
  description="Dong Ho Co Dien — Curating rare, authentic vintage timepieces from Switzerland and Japan for global collectors."
>
  <section class="relative w-full border-b border-stone-200">
    <HeroCarousel client:load />
  </section>

  <section class="py-16 sm:py-24 bg-white border-b border-stone-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
        <div class="lg:col-span-7 space-y-6">
          <h2 class="text-lg sm:text-2xl lg:text-3xl font-serif uppercase tracking-[0.12em] text-stone-900 leading-snug">
            SPACETIME – A MISSION TO BRING ELEGANCE TO MILLIONS OF WRISTS
          </h2>

          <div class="space-y-4 text-xs sm:text-sm text-stone-600 leading-relaxed font-sans font-light">
            <p>
              Vintage watches have long left deep imprints across time — marking decades, even centuries — evoking memories of a bygone era. Born with the mission to deliver timeless elegance to every wrist, Spacetime represents two precious moments we all hold dear: “Now and Here.” With each passing second, we’re reminded to live fully in the present — no matter the time, no matter the place.
            </p>
            <p>
              From wandering the world to expressing your unique style, wherever you are and whatever you do, Spacetime is always with you — here, now, and on your wrist.
            </p>
          </div>

          <div class="pt-2">
            <a
              href="/about-us"
              class="inline-block text-xs uppercase tracking-[0.2em] font-medium text-stone-900 border-b border-stone-900 pb-1 hover:text-stone-500 hover:border-stone-500 transition-colors"
            >
              READ MORE &lt;&lt;
            </a>
          </div>
        </div>

        <div class="lg:col-span-5 flex justify-center">
          <div class="relative w-full max-w-md aspect-[4/5] overflow-hidden shadow-xl bg-stone-100 group">
            <img
              src="/images/brand-story.jpg"
              alt="Spacetime Vintage Timepiece on Leather"
              class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-24 bg-brand-surface-subtle border-b border-stone-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 sm:mb-16">
        <div class="w-12 h-px bg-stone-300 mx-auto mb-4"></div>
        <h2 class="text-xl sm:text-2xl lg:text-3xl font-serif uppercase tracking-[0.2em] text-stone-900 font-normal">
          <a href="/shop" class="hover:text-stone-500 transition-colors">
            SHOP NOW
          </a>
        </h2>
        <p class="text-xs sm:text-sm text-stone-500 italic mt-2">
          Come visit our online store
        </p>
      </div>

      {hasProductError && (
        <div class="p-6 bg-red-50 border border-red-200 text-red-700 text-xs text-center max-w-lg mx-auto">
          Temporary latency connecting to WooCommerce API. Please refresh the page.
        </div>
      )}

      {products.length > 0 && (
        <ProductCarousel client:visible products={products} />
      )}

      <div class="mt-14 text-center">
        <a
          href="/shop"
          class="inline-block px-10 py-3.5 border border-stone-900 text-stone-900 text-xs uppercase tracking-[0.2em] font-medium hover:bg-stone-900 hover:text-white transition-colors"
        >
          Discover All 2,300+ Watches &rarr;
        </a>
      </div>
    </div>
  </section>
</Layout>
