---
import Layout from '../layouts/Layout.astro';
import WatchCard from '../components/WatchCard.astro';
import { Effect } from 'effect';
import { getProducts } from '../lib/services/woocommerce';
import { ArrowRight } from 'lucide-react';

// Fetch live watches via Effect pipeline
const productsResult = await Effect.runPromiseExit(getProducts({ per_page: 12 }));

const products = productsResult._tag === 'Success' ? productsResult.value : [];
const hasError = productsResult._tag === 'Failure';

const curatedBrands = [
  { name: 'Omega', slug: 'omega' },
  { name: 'Cartier Tank', slug: 'cartier' },
  { name: 'Rolex', slug: 'rolex' },
  { name: 'Seiko Vintage', slug: 'seiko' },
  { name: 'Longines', slug: 'longines' },
  { name: 'Zenith', slug: 'zenith' },
];
---

<Layout title="Spacetime - Vintage Watch | Authentic Swiss & Japanese Timepieces">
  {/* Hero Banner Section */}
  <section class="relative bg-[#f8f8f8] border-b border-stone-200 py-16 sm:py-24 text-center">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <p class="text-[11px] sm:text-xs uppercase tracking-[0.3em] text-stone-500 font-medium mb-3">
        Spacetime &bull; Vintage Watch Atelier
      </p>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl text-stone-900 font-normal tracking-tight leading-[1.2] mb-6">
        Curating Timeless <br class="hidden sm:inline" />
        <span class="italic">Mechanical Heritage.</span>
      </h1>

      <p class="max-w-xl mx-auto text-stone-600 text-xs sm:text-sm leading-relaxed mb-8">
        Rare, authentic, and mechanically certified vintage timepieces from Switzerland and Japan, curated for international connoisseurs.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href="/shop"
          class="w-full sm:w-auto px-8 py-3 bg-[#191414] text-white text-xs uppercase tracking-[0.2em] font-medium hover:bg-stone-700 transition-colors"
        >
          View Collection
        </a>
        <a
          href="/consign-your-watch"
          class="w-full sm:w-auto px-8 py-3 border border-stone-400 text-stone-800 text-xs uppercase tracking-[0.2em] font-medium hover:bg-stone-100 transition-colors"
        >
          Consign A Watch
        </a>
      </div>
    </div>
  </section>

  {/* Brand Quick Links */}
  <section class="border-b border-stone-200 bg-white py-4 overflow-x-auto">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-start sm:justify-center gap-3 min-w-max">
      <span class="text-[11px] uppercase tracking-widest text-stone-400 font-medium pr-2">
        Popular:
      </span>
      {curatedBrands.map((b) => (
        <a
          href={`/shop?search=${b.slug}`}
          class="px-3 py-1 bg-stone-50 border border-stone-200 text-stone-700 text-[11px] uppercase tracking-wider hover:border-stone-900 transition-colors"
        >
          {b.name}
        </a>
      ))}
    </div>
  </section>

  {/* Fresh Arrivals - Responsive 4-Column on Desktop / 2-Column on Mobile */}
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
    <div class="flex items-end justify-between mb-8 sm:mb-12 border-b border-stone-200 pb-4">
      <div>
        <h2 class="text-xl sm:text-2xl uppercase tracking-[0.18em] text-stone-900 font-medium">
          Recent Arrivals
        </h2>
        <p class="text-xs text-stone-500 mt-1">
          Authentic vintage pieces freshly acquired &amp; serviced.
        </p>
      </div>

      <a
        href="/shop"
        class="inline-flex items-center gap-1.5 text-xs uppercase tracking-[0.15em] text-stone-700 hover:text-stone-950 font-medium transition-colors"
      >
        <span>All 2,300+ Watches</span>
        <ArrowRight class="w-3.5 h-3.5" />
      </a>
    </div>

    {hasError && (
      <div class="p-6 bg-red-50 border border-red-200 text-red-700 text-xs">
        Temporary server latency connecting to WooCommerce API. Please refresh the page.
      </div>
    )}

    {/* Responsive Grid: 2 cols on mobile, 3 on tablet, 4 on desktop */}
    {products.length > 0 && (
      <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6 lg:gap-8">
        {products.map((watch) => (
          <WatchCard product={watch} />
        ))}
      </div>
    )}

    <div class="mt-16 text-center">
      <a
        href="/shop"
        class="inline-block px-10 py-3.5 border border-[#191414] text-[#191414] text-xs uppercase tracking-[0.2em] font-medium hover:bg-[#191414] hover:text-white transition-colors"
      >
        Discover All Timepieces &rarr;
      </a>
    </div>
  </main>
</Layout>
