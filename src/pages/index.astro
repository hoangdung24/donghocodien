---
import Layout from '../layouts/Layout.astro';
import HeroCarousel from '../components/HeroCarousel';
import ProductCarousel from '../components/ProductCarousel';
import { Effect } from 'effect';
import { getProducts } from '../lib/services/woocommerce';
import { SITE, SEO } from '../lib/constants';

const productsResult = await Effect.runPromiseExit(getProducts({ per_page: 12 }));

const products = productsResult._tag === 'Success' ? productsResult.value : [];
const hasProductError = productsResult._tag === 'Failure';
---

<Layout title={SEO.defaultTitle} description={SEO.defaultDescription}>
  <section class='relative w-full'>
    <HeroCarousel client:load />
  </section>

  <section class='py-16 sm:py-24 bg-white'>
    <div class='max-w-7xl mx-auto px-4 sm:px-6 lg:px-8'>
      <div class='grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center'>
        <div class='lg:col-span-7 space-y-6'>
          <h2 class='text-lg sm:text-2xl lg:text-3xl font-serif uppercase tracking-[0.12em] text-black leading-snug'>
            SPACETIME – A MISSION TO BRING ELEGANCE TO MILLIONS OF WRISTS
          </h2>

          <div class='space-y-4 text-xs sm:text-sm text-stone-600 leading-relaxed font-sans font-light'>
            <p>
              Vintage watches have long left deep imprints across time — marking decades, even
              centuries — evoking memories of a bygone era. Born with the mission to deliver
              timeless elegance to every wrist, {SITE.name} represents two precious moments we all
              hold dear: “Now and Here.” With each passing second, we’re reminded to live fully in
              the present — no matter the time, no matter the place.
            </p>
            <p>
              From wandering the world to expressing your unique style, wherever you are and
              whatever you do, {SITE.name} is always with you — here, now, and on your wrist.
            </p>
          </div>

          <div class='pt-2'>
            <a
              href='/about-us'
              class='inline-block text-xs uppercase tracking-[0.2em] font-medium text-black border-b border-black pb-1 hover:text-stone-500 hover:border-stone-500 transition-colors'
            >
              READ MORE &lt;&lt;
            </a>
          </div>
        </div>

        <div class='lg:col-span-5 flex justify-center'>
          <div class='relative w-full max-w-md aspect-4/5 overflow-hidden shadow-xl bg-stone-100 group'>
            <img
              src='/images/brand-story.jpg'
              alt={`${SITE.name} Vintage Timepiece on Leather`}
              class='w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105'
              loading='lazy'
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class='py-16 sm:py-24 bg-white border-b border-stone-200'>
    <div class='max-w-7xl mx-auto px-4 sm:px-6 lg:px-8'>
      <div class='text-center mb-12 sm:mb-16'>
        <div class='w-12 h-px bg-stone-300 mx-auto mb-4'></div>
        <h2 class='text-xl sm:text-2xl lg:text-3xl font-serif uppercase tracking-[0.2em] text-black font-normal'>
          <a href='/shop' class='hover:text-stone-500 transition-colors'>
            SHOP NOW
          </a>
        </h2>
        <p class='text-xs sm:text-sm text-stone-500 italic mt-2'>Come visit our online store</p>
      </div>

      {hasProductError && (
        <div class='p-6 bg-red-50 border border-red-200 text-red-700 text-xs text-center max-w-lg mx-auto'>
          Temporary latency connecting to WooCommerce API. Please refresh the page.
        </div>
      )}

      {products.length > 0 && <ProductCarousel client:visible products={products} />}

      <div class='mt-14 text-center'>
        <a
          href='/shop'
          class='inline-block px-10 py-3.5 border border-black text-black text-xs uppercase tracking-[0.2em] font-medium hover:bg-stone-900 hover:text-white transition-colors'
        >
          Discover All 2,300+ Watches &rarr;
        </a>
      </div>
    </div>
  </section>
</Layout>
