---
import Layout from '@/layouts/Layout.astro';
import { CheckoutPage } from '@/components/CheckoutPage';
---

<Layout title='Checkout' description='Complete your purchase of authentic vintage timepieces.'>
  <div
    slot='before-footer'
    class='mx-auto hidden w-full max-w-7xl flex-1 px-4 py-10 min-[380px]:block sm:px-6 sm:py-16 lg:px-8 print:hidden'
  >
    <div aria-busy='true' class='flex min-h-[1150px] flex-col'>
      <div role='status'>
        <span class='sr-only'>Loading checkout</span>
      </div>
      <div class='grid grid-cols-1 gap-8 lg:grid-cols-5 lg:gap-12'>
        <div class='flex flex-col gap-5 lg:col-span-3'>
          <div class='h-7 w-48 bg-stone-200/70'></div>
          <div class='grid grid-cols-1 gap-5 sm:grid-cols-2'>
            <div class='h-11 bg-stone-200/70'></div>
            <div class='h-11 bg-stone-200/70'></div>
          </div>
          <div class='h-11 bg-stone-200/70'></div>
          <div class='h-11 bg-stone-200/70'></div>
          <div class='h-11 bg-stone-200/70'></div>
          <div class='grid grid-cols-1 gap-5 sm:grid-cols-2'>
            <div class='h-11 bg-stone-200/70'></div>
            <div class='h-11 bg-stone-200/70'></div>
          </div>
          <div class='h-24 bg-stone-200/70'></div>
        </div>
        <div class='lg:col-span-2'>
          <div class='border border-stone-200 bg-white p-6'>
            <div class='mb-4 h-5 w-32 bg-stone-200/70'></div>
            <div class='flex items-center gap-4 py-4'>
              <div class='h-20 w-16 shrink-0 bg-stone-200/70'></div>
              <div class='flex-1'>
                <div class='mb-2 h-4 w-full bg-stone-200/70'></div>
                <div class='h-3 w-12 bg-stone-200/70'></div>
              </div>
            </div>
            <div class='mt-4 flex flex-col gap-3 border-t border-stone-200 pt-4'>
              <div class='h-4 w-full bg-stone-200/70'></div>
              <div class='h-4 w-full bg-stone-200/70'></div>
              <div class='h-5 w-full bg-stone-200/70'></div>
            </div>
            <div class='mt-6 h-12 w-full bg-stone-200/70'></div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <CheckoutPage client:load />
  <script>
    import '@/lib/pendingSlot';
  </script>
</Layout>
