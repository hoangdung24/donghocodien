---
import type { Product } from '../lib/schema/product';
import { formatApproxVND } from '../lib/utils/currency';

interface Props {
  product: Product;
}

const { product } = Astro.props;

// Find brand or primary category
const primaryCategory = product.categories.find((c) =>
  ['Omega', 'Rolex', 'Cartier', 'Edox', 'Eterna', 'Seiko', 'Farve-Leuba', 'Zenith', 'Longines', 'Universal Geneve', 'Tudor'].some(
    (b) => c.name.toLowerCase().includes(b.toLowerCase())
  )
) || product.categories[0];

const mainImage = product.images[0]?.src || '/placeholder-watch.jpg';
const hoverImage = product.images[1]?.src || mainImage;

function cleanTitle(title: string) {
  return title
    .replace(/&#8216;/g, '‘')
    .replace(/&#8217;/g, '’')
    .replace(/&#8211;/g, '–')
    .replace(/&#038;/g, '&')
    .replace(/&amp;/g, '&');
}

const cleanName = cleanTitle(product.name);
---

<article class="group relative flex flex-col bg-white overflow-hidden transition-all duration-300">
  {/* Watch Image Box with Aspect Ratio 300/375 & Fade-to-back Hover */}
  <a href={`/product/${product.slug}`} class="relative block aspect-[300/375] overflow-hidden bg-[#fbfbfb]">
    <img
      src={mainImage}
      alt={cleanName}
      loading="lazy"
      class="h-full w-full object-cover transition-opacity duration-500 ease-in-out group-hover:opacity-0"
    />
    <img
      src={hoverImage}
      alt={`${cleanName} alternate angle`}
      loading="lazy"
      class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-500 ease-in-out group-hover:opacity-100"
    />

    {/* Badges */}
    <div class="absolute top-2 left-2 flex flex-col gap-1 z-10">
      {product.on_sale && (
        <span class="bg-[#dc3232] text-white text-[9px] sm:text-[10px] uppercase font-sans tracking-widest px-2 py-0.5">
          Sale
        </span>
      )}
      {!product.is_in_stock && (
        <span class="bg-[#191414] text-white text-[9px] sm:text-[10px] uppercase font-sans tracking-widest px-2 py-0.5">
          Sold
        </span>
      )}
    </div>
  </a>

  {/* Timepiece Meta Information */}
  <div class="flex flex-1 flex-col pt-3 pb-4 text-center sm:text-left px-1">
    {primaryCategory && (
      <p class="text-[10px] sm:text-[11px] uppercase tracking-[0.15em] text-stone-400 mb-1 truncate">
        {cleanTitle(primaryCategory.name)}
      </p>
    )}

    <h3 class="text-xs sm:text-sm text-stone-900 leading-snug tracking-normal mb-1.5 line-clamp-2">
      <a href={`/product/${product.slug}`} class="hover:text-stone-500 transition-colors">
        {cleanName}
      </a>
    </h3>

    <div class="mt-auto flex flex-col items-center sm:items-start pt-1 font-serif">
      <div class="flex items-baseline gap-2">
        {product.on_sale && product.prices.regular_price && (
          <span class="text-xs text-stone-400 line-through">
            ${product.prices.regular_price}
          </span>
        )}
        <span class="text-sm sm:text-base font-semibold text-stone-950">
          ${product.prices.price}
        </span>
      </div>
      <span class="text-[10px] sm:text-[11px] text-stone-400 font-sans tracking-tight mt-0.5 approximate-vnd" data-usd-price={product.prices.price}>
        {formatApproxVND(product.prices.price)}
      </span>
    </div>
  </div>
</article>
