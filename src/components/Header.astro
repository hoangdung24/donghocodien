---
import { Search, ShoppingBag, Menu, X, ChevronDown } from '@lucide/astro';
import { formatHeaderClock } from '../lib/utils/format';

export const megaMenuData = [
  {
    title: 'MARKET SEGMENT',
    items: [
      { label: 'Rare & Collectible', href: '/shop?category=125' },
      { label: 'Super Premium', href: '/shop?category=124' },
      { label: 'Premium', href: '/shop?category=123' },
      { label: 'Fashion', href: '/shop?category=75' },
      { label: 'Affordable', href: '/shop?category=121' },
    ],
  },
  {
    title: 'GENDER',
    items: [
      { label: 'Unisex', href: '/shop?category=164' },
      { label: 'Male', href: '/shop?category=162' },
      { label: 'Female', href: '/shop?category=163' },
    ],
  },
  {
    title: 'BRAND',
    items: [
      { label: 'Patek Philippe', href: '/shop?category=91' },
      { label: 'Rolex', href: '/shop?category=85' },
      { label: 'Omega', href: '/shop?category=79' },
      { label: 'Cartier', href: '/shop?category=76' },
    ],
  },
  {
    title: 'MOVEMENT',
    items: [
      { label: 'Automatic', href: '/shop?category=156' },
      { label: 'Hand Wind', href: '/shop?category=157' },
      { label: 'Quartz', href: '/shop?category=158' },
    ],
  },
  {
    title: 'SIZE',
    items: [
      { label: '20 – 30 mm', href: '/shop?category=166' },
      { label: '30 – 40 mm', href: '/shop?category=167' },
    ],
  },
  {
    title: 'WATCH FEATURES',
    items: [
      { label: 'Time-Only', href: '/shop?category=154' },
      { label: 'Chronograph', href: '/shop?category=81' },
      { label: 'Calendar', href: '/shop?category=82' },
      { label: 'Moon Phase', href: '/shop?category=84' },
      { label: 'Sun & Moon', href: '/shop?category=83' },
    ],
  },
];

const currentPath = Astro.url.pathname + Astro.url.search;
---

<header class="sticky top-0 z-40 w-full bg-white border-b border-stone-200 transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-3 sm:gap-4 flex-1 justify-start">
        <button
          type="button"
          id="mobile-menu-toggle"
          aria-label="Open navigation menu"
          class="p-1.5 text-stone-800 lg:hidden cursor-pointer"
        >
          <Menu class="w-6 h-6" />
        </button>

        <span
          id="header-live-clock"
          class="hidden sm:inline-block text-xs font-mono tracking-wider text-stone-700 select-none font-light"
        >
          {formatHeaderClock(new Date())}
        </span>

        <a
          href="https://instagram.com"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram @donghocodien"
          class="hidden sm:inline-flex p-1.5 text-stone-800 hover:text-stone-500 transition-colors"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
          </svg>
        </a>
      </div>

      <div class="text-center flex-initial">
        <a href="/" class="inline-block group py-1" title="Spacetime - Vintage Watch">
          <span class="block text-xl sm:text-2xl font-normal tracking-[0.38em] text-stone-950 font-serif leading-none">
            SPACETIME
          </span>
          <span class="block text-[10px] sm:text-[11px] font-normal tracking-[0.32em] text-stone-800 mt-2 uppercase leading-none">
            VINTAGE WATCH
          </span>
        </a>
      </div>

      <div class="flex items-center gap-4 sm:gap-5 flex-1 justify-end">
        <a
          href="/cart"
          aria-label="Cart"
          class="inline-flex items-center justify-center px-2.5 py-1 border border-stone-300 text-stone-800 hover:border-stone-900 text-xs font-mono font-medium transition-colors"
        >
          0
        </a>

        <a
          href="/shop?search=true"
          aria-label="Search"
          class="p-1.5 text-stone-800 hover:text-stone-500 transition-colors"
        >
          <Search class="w-4 h-4" />
        </a>
      </div>
    </div>
  </div>

  <div class="border-t border-stone-100 hidden lg:block relative" id="tier2-nav-container">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-stretch justify-center gap-8 text-xs uppercase tracking-[0.18em] font-medium text-stone-800">
        <div id="watches-menu-wrapper" class="group flex items-center py-3.5">
          <a
            href="/shop"
            id="watches-menu-trigger"
            class="inline-flex items-center gap-1 hover:text-stone-500 transition-colors cursor-pointer py-1"
          >
            <span>Watches</span>
            <ChevronDown id="watches-chevron" class="w-3.5 h-3.5 text-stone-400 group-hover:rotate-180 transition-transform duration-200" />
          </a>

          <div
            id="watches-mega-menu"
            class="invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-all duration-200 ease-out absolute left-1/2 -translate-x-1/2 top-full w-screen max-w-5xl px-4 sm:px-6 lg:px-8 z-50 pointer-events-none group-hover:pointer-events-auto before:content-[''] before:absolute before:-top-4 before:left-0 before:right-0 before:h-4 before:block"
          >
            <div class="bg-white border border-stone-200 shadow-2xl p-8 sm:p-10 w-full">
              <div class="grid grid-cols-6 gap-6">
                {megaMenuData.map((column) => (
                  <div class="flex flex-col min-w-0">
                    <h4 class="text-[11px] uppercase tracking-[0.2em] font-bold text-stone-900 pb-3 border-b border-stone-100 mb-2 whitespace-nowrap">
                      {column.title}
                    </h4>
                    <ul class="divide-y divide-stone-100 text-xs">
                      {column.items.map((item) => {
                        const isActive = currentPath === item.href;
                        return (
                          <li class="py-2.5">
                            <a
                              href={item.href}
                              class={`transition-colors block tracking-wide whitespace-nowrap ${
                                isActive
                                  ? 'font-bold text-stone-950'
                                  : 'text-stone-600 hover:text-stone-950 hover:font-bold'
                              }`}
                            >
                              {item.label}
                            </a>
                          </li>
                        );
                      })}
                    </ul>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>

        <a href="/consign-your-watch" class="flex items-center hover:text-stone-500 transition-colors py-3.5">
          Consignment
        </a>
        <a href="/blog" class="flex items-center hover:text-stone-500 transition-colors py-3.5">
          Articles
        </a>
        <a href="/about-us" class="flex items-center hover:text-stone-500 transition-colors py-3.5">
          About Us
        </a>
        <a href="/shop?status=archive" class="flex items-center hover:text-stone-500 transition-colors py-3.5">
          Archives
        </a>
        <a href="/consign-your-watch" class="flex items-center hover:text-stone-500 transition-colors py-3.5">
          Consign Your Watch
        </a>
      </nav>
    </div>
  </div>

  <div
    id="mobile-drawer"
    class="fixed inset-0 z-50 bg-stone-950/50 backdrop-blur-xs transition-opacity duration-300 opacity-0 pointer-events-none lg:hidden"
  >
    <div
      id="mobile-drawer-content"
      class="fixed inset-y-0 left-0 w-4/5 max-w-md bg-white shadow-2xl p-6 flex flex-col transform -translate-x-full transition-transform duration-300 ease-out overflow-y-auto"
    >
      <div class="flex items-center justify-between pb-4 border-b border-stone-200">
        <span class="text-sm tracking-[0.25em] font-serif font-bold text-stone-900">
          SPACETIME
        </span>
        <button
          type="button"
          id="mobile-menu-close"
          aria-label="Close menu"
          class="p-2 text-stone-500 hover:text-stone-900 cursor-pointer"
        >
          <X class="w-5 h-5" />
        </button>
      </div>

      <nav class="py-6 space-y-4 text-xs uppercase tracking-[0.18em]">
        <div class="border-b border-stone-100 pb-3">
          <button
            type="button"
            id="mobile-watches-toggle"
            class="flex items-center justify-between w-full py-2 font-bold text-stone-900 cursor-pointer"
          >
            <span>Watches</span>
            <ChevronDown id="mobile-watches-icon" class="w-4 h-4 text-stone-400 transition-transform duration-200" />
          </button>

          <div id="mobile-watches-content" class="hidden pl-2 pt-2 space-y-4">
            {megaMenuData.map((col) => (
              <div class="space-y-1.5">
                <p class="text-[10px] font-bold text-stone-400 tracking-wider">
                  {col.title}
                </p>
                <div class="pl-2 space-y-1">
                  {col.items.map((item) => {
                    const isActive = currentPath === item.href;
                    return (
                      <a
                        href={item.href}
                        class={`block py-1 text-[11px] normal-case transition-colors ${
                          isActive
                            ? 'font-bold text-stone-950'
                            : 'text-stone-600 hover:text-stone-950 hover:font-bold'
                        }`}
                      >
                        {item.label}
                      </a>
                    );
                  })}
                </div>
              </div>
            ))}
          </div>
        </div>

        <a href="/consign-your-watch" class="block py-2 text-stone-800 hover:text-stone-500 border-b border-stone-100">
          Consignment
        </a>
        <a href="/blog" class="block py-2 text-stone-800 hover:text-stone-500 border-b border-stone-100">
          Articles
        </a>
        <a href="/about-us" class="block py-2 text-stone-800 hover:text-stone-500 border-b border-stone-100">
          About Us
        </a>
        <a href="/shop?status=archive" class="block py-2 text-stone-800 hover:text-stone-500 border-b border-stone-100">
          Archives
        </a>
        <a href="/consign-your-watch" class="block py-2 text-stone-800 hover:text-stone-500">
          Consign Your Watch
        </a>
      </nav>

      <div class="mt-auto pt-6 border-t border-stone-200 text-xs text-stone-500 space-y-2">
        <p>WhatsApp: <a href="https://wa.me/84941625653" class="text-stone-900 font-medium">+84 94 162 5653</a></p>
        <p>Email: <a href="mailto:spacetime.donghocodien@gmail.com" class="text-stone-900 font-medium">spacetime.donghocodien@gmail.com</a></p>
      </div>
    </div>
  </div>
</header>

<script>
  import { formatHeaderClock } from '../lib/utils/format';

  const clockEl = document.getElementById('header-live-clock');
  if (clockEl) {
    const tick = () => {
      clockEl.textContent = formatHeaderClock(new Date());
    };
    setInterval(tick, 1000);
  }

  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const closeBtn = document.getElementById('mobile-menu-close');
  const drawer = document.getElementById('mobile-drawer');
  const drawerContent = document.getElementById('mobile-drawer-content');
  const watchesToggle = document.getElementById('mobile-watches-toggle');
  const watchesContent = document.getElementById('mobile-watches-content');
  const watchesIcon = document.getElementById('mobile-watches-icon');

  const watchesWrapper = document.getElementById('watches-menu-wrapper');
  const watchesMegaMenu = document.getElementById('watches-mega-menu');
  const watchesChevron = document.getElementById('watches-chevron');
  let closeTimer: ReturnType<typeof setTimeout> | null = null;

  function showMegaMenu() {
    if (closeTimer) {
      clearTimeout(closeTimer);
      closeTimer = null;
    }
    watchesMegaMenu?.classList.remove('invisible', 'opacity-0', 'pointer-events-none');
    watchesMegaMenu?.classList.add('visible', 'opacity-100', 'pointer-events-auto');
    watchesChevron?.classList.add('rotate-180');
  }

  function scheduleHideMegaMenu() {
    if (closeTimer) clearTimeout(closeTimer);
    closeTimer = setTimeout(() => {
      watchesMegaMenu?.classList.remove('visible', 'opacity-100', 'pointer-events-auto');
      watchesMegaMenu?.classList.add('invisible', 'opacity-0', 'pointer-events-none');
      watchesChevron?.classList.remove('rotate-180');
      closeTimer = null;
    }, 280);
  }

  watchesWrapper?.addEventListener('mouseenter', showMegaMenu);
  watchesWrapper?.addEventListener('mouseleave', scheduleHideMegaMenu);
  watchesMegaMenu?.addEventListener('mouseenter', showMegaMenu);
  watchesMegaMenu?.addEventListener('mouseleave', scheduleHideMegaMenu);

  function openMenu() {
    drawer?.classList.remove('opacity-0', 'pointer-events-none');
    drawer?.classList.add('opacity-100');
    drawerContent?.classList.remove('-translate-x-full');
    drawerContent?.classList.add('translate-x-0');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    drawer?.classList.add('opacity-0', 'pointer-events-none');
    drawer?.classList.remove('opacity-100');
    drawerContent?.classList.add('-translate-x-full');
    drawerContent?.classList.remove('translate-x-0');
    document.body.style.overflow = '';
  }

  toggleBtn?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  drawer?.addEventListener('click', (e) => {
    if (e.target === drawer) closeMenu();
  });

  watchesToggle?.addEventListener('click', () => {
    const isHidden = watchesContent?.classList.contains('hidden');
    if (isHidden) {
      watchesContent?.classList.remove('hidden');
      watchesIcon?.classList.add('rotate-180');
    } else {
      watchesContent?.classList.add('hidden');
      watchesIcon?.classList.remove('rotate-180');
    }
  });
</script>
