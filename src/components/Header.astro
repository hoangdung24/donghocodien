---
import { Search, ShoppingBag, Menu } from 'lucide-react';
---

<header class="sticky top-0 z-40 w-full border-b border-stone-200/80 bg-stone-50/95 backdrop-blur-md">
  {/* Top Announcement Bar */}
  <div class="border-b border-stone-200/60 bg-stone-900 text-stone-200 py-1.5 px-4 text-center text-xs tracking-widest uppercase font-sans">
    <span>Curated Authentic Vintage Swiss &amp; Japanese Timepieces — Worldwide Insured Delivery</span>
  </div>

  {/* Main Header */}
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      {/* Mobile Menu trigger */}
      <div class="flex items-center md:hidden">
        <button type="button" aria-label="Open menu" class="p-2 text-stone-700 hover:text-stone-950">
          <Menu class="w-6 h-6" />
        </button>
      </div>

      {/* Brand Logo */}
      <div class="flex-1 text-center md:text-left md:flex-initial">
        <a href="/" class="inline-block group">
          <span class="font-serif text-2xl sm:text-3xl font-bold tracking-tight text-stone-900 block group-hover:text-amber-900 transition-colors">
            DONG HO CO DIEN
          </span>
          <span class="block text-[10px] uppercase tracking-[0.25em] text-stone-500 text-center md:text-left mt-0.5">
            Vintage Watches &amp; Horology
          </span>
        </a>
      </div>

      {/* Desktop Navigation */}
      <nav class="hidden md:flex items-center gap-8">
        <a href="/shop" class="text-sm font-sans tracking-wider uppercase text-stone-700 hover:text-amber-900 transition-colors">
          Collection
        </a>
        <a href="/about-us" class="text-sm font-sans tracking-wider uppercase text-stone-700 hover:text-amber-900 transition-colors">
          About
        </a>
        <a href="/consign-your-watch" class="text-sm font-sans tracking-wider uppercase text-stone-700 hover:text-amber-900 transition-colors">
          Consignment
        </a>
        <a href="/maintain" class="text-sm font-sans tracking-wider uppercase text-stone-700 hover:text-amber-900 transition-colors">
          Restoration &amp; Care
        </a>
        <a href="/blog" class="text-sm font-sans tracking-wider uppercase text-stone-700 hover:text-amber-900 transition-colors">
          Journal
        </a>
        <a href="/contact-us" class="text-sm font-sans tracking-wider uppercase text-stone-700 hover:text-amber-900 transition-colors">
          Contact
        </a>
      </nav>

      {/* Quick Actions */}
      <div class="flex items-center gap-4">
        <a href="/shop?search=true" aria-label="Search collection" class="p-2 text-stone-700 hover:text-stone-950 transition-colors">
          <Search class="w-5 h-5" />
        </a>
        <a href="/cart" aria-label="Cart" class="p-2 text-stone-700 hover:text-stone-950 transition-colors relative">
          <ShoppingBag class="w-5 h-5" />
        </a>
      </div>
    </div>
  </div>
</header>
