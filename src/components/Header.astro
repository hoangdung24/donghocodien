---
import { Search, Menu, X, ChevronDown } from '@lucide/astro';
import { formatHeaderClock } from '@/lib/utils/format';
import SocialIcon from '@/components/SocialIcon.astro';
import SearchBox from '@/components/SearchBox.astro';
import { CartDrawer } from '@/components/CartDrawer';
import { CONTACT, SOCIAL } from '@/lib/constants';
import { megaMenuData } from '@/lib/data/megaMenu';

const currentPath = Astro.url.pathname + Astro.url.search;
const activeCategory = Astro.url.searchParams.get('category');
---

<header class='sticky top-0 z-40 w-full border-b border-stone-200 bg-white transition-all'>
  <div class='mx-auto max-w-7xl px-4 py-5 sm:px-6 lg:px-8'>
    <div class='flex items-center justify-between'>
      <div class='flex flex-1 items-center justify-start gap-3 sm:gap-4'>
        <button
          type='button'
          id='mobile-menu-toggle'
          aria-label='Open navigation menu'
          class='cursor-pointer p-1.5 lg:hidden'
        >
          <Menu class='h-5 w-5' />
        </button>

        <span
          id='header-live-clock'
          class='hidden font-mono text-xs font-light tracking-wider text-stone-500 select-none sm:landscape:inline-block'
        >
          {formatHeaderClock(new Date())}
        </span>

        <a
          href={SOCIAL.instagram}
          target='_blank'
          rel='noopener noreferrer'
          aria-label='Instagram @spacetime.vintagewatch'
          class='hidden p-1.5 transition-colors hover:text-stone-500 sm:inline-flex'
        >
          <SocialIcon name='instagram' class='h-5 w-5' strokeWidth={1.8} />
        </a>
      </div>

      <div class='flex-initial text-center'>
        <a href='/' class='group inline-block py-1' title='Spacetime - Vintage Watch'>
          <span class='block text-xl leading-none font-normal tracking-[0.38em] sm:text-2xl'>
            SPACETIME
          </span>
          <span class='mt-2 block text-[10px] leading-none font-normal tracking-[0.32em] text-stone-600 uppercase sm:text-[11px]'>
            VINTAGE WATCH
          </span>
        </a>
      </div>

      <div class='flex flex-1 items-center justify-end gap-4 sm:gap-5'>
        <CartDrawer client:only='react' />

        <div id='header-search' class='relative hidden lg:block'>
          <button
            type='button'
            id='header-search-toggle'
            aria-label='Open search'
            aria-expanded='false'
            aria-controls='header-search-panel'
            class='inline-flex cursor-pointer p-1.5 transition-colors hover:text-stone-500'
          >
            <Search class='h-4 w-4' />
          </button>

          <div
            id='header-search-panel'
            class='pointer-events-none invisible absolute top-full right-0 z-50 mt-4 w-[min(22rem,calc(100vw-2rem))] translate-y-1 bg-white opacity-0 shadow-2xl transition-[opacity,transform] duration-150 ease-out'
            role='dialog'
            aria-label='Search watches'
          >
            <SearchBox
              id='header-search-input'
              placeholder='Search…'
              category={activeCategory}
              className='p-4'
            />
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class='relative hidden border-t border-stone-100 lg:block' id='tier2-nav-container'>
    <div class='mx-auto max-w-7xl px-4 sm:px-6 lg:px-8'>
      <nav class='flex items-stretch justify-center gap-8 text-xs font-medium tracking-[0.18em] text-stone-700 uppercase'>
        <div id='watches-menu-wrapper' class='group flex items-center py-3.5'>
          <a
            href='/watches'
            id='watches-menu-trigger'
            class='inline-flex cursor-pointer items-center gap-1 py-1 transition-colors hover:text-brand-dark'
          >
            <span>Watches</span>
            <ChevronDown
              id='watches-chevron'
              class='h-3.5 w-3.5 text-stone-400 transition-transform duration-200 group-hover:rotate-180'
            />
          </a>

          <div
            id='watches-mega-menu'
            class="pointer-events-none invisible absolute top-full left-1/2 z-50 w-screen max-w-5xl -translate-x-1/2 px-4 opacity-0 transition-all duration-200 ease-out group-hover:pointer-events-auto group-hover:visible group-hover:opacity-100 before:absolute before:-top-4 before:right-0 before:left-0 before:block before:h-4 before:content-[''] sm:px-6 lg:px-8"
          >
            <div class='w-full border border-stone-200 bg-white p-8 shadow-2xl sm:p-10'>
              <div class='grid grid-cols-6 gap-6'>
                {megaMenuData.map((column) => (
                  <div class='flex min-w-0 flex-col'>
                    <a
                      href={column.href}
                      class='mb-2 block border-b border-stone-100 pb-3 transition-opacity hover:opacity-70'
                    >
                      <h4 class='text-[11px] font-bold tracking-[0.2em] whitespace-nowrap text-brand-dark uppercase'>
                        {column.title}
                      </h4>
                    </a>
                    <ul class='divide-y divide-stone-100 text-xs'>
                      {column.items.map((item) => {
                        const isActive = currentPath === item.href;
                        return (
                          <li class='py-2.5'>
                            <a
                              href={item.href}
                              class={`block tracking-wide whitespace-nowrap transition-colors ${
                                isActive
                                  ? 'font-bold text-brand-dark'
                                  : 'text-stone-600 hover:font-bold hover:text-brand-dark'
                              }`}
                            >
                              {item.label}
                            </a>
                          </li>
                        );
                      })}
                    </ul>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>

        <a
          href='/archives'
          class='flex items-center py-3.5 transition-colors hover:text-brand-dark'
        >
          Archives
        </a>
        <a
          href='/about-us'
          class='flex items-center py-3.5 transition-colors hover:text-brand-dark'
        >
          About Us
        </a>
      </nav>
    </div>
  </div>

  <div
    id='mobile-drawer'
    class='pointer-events-none fixed inset-0 z-50 bg-black/50 opacity-0 backdrop-blur-xs transition-opacity duration-300 lg:hidden'
  >
    <div
      id='mobile-drawer-content'
      class='fixed inset-y-0 left-0 flex w-4/5 max-w-md -translate-x-full transform flex-col overflow-y-auto bg-white p-6 shadow-2xl transition-transform duration-300 ease-out'
    >
      <div class='flex items-center justify-between border-b border-stone-200 pb-4'>
        <span class='text-sm font-bold tracking-[0.25em]'>SPACETIME</span>
        <button
          type='button'
          id='mobile-menu-close'
          aria-label='Close menu'
          class='cursor-pointer p-2 text-stone-500 hover:text-brand-dark'
        >
          <X class='h-5 w-5' />
        </button>
      </div>

      <nav class='flex flex-col gap-4 py-6 text-xs tracking-[0.18em] uppercase'>
        <div>
          <button
            type='button'
            id='mobile-watches-toggle'
            class='flex w-full cursor-pointer items-center justify-between py-2 font-bold'
          >
            <span>Watches</span>
            <ChevronDown
              id='mobile-watches-icon'
              class='h-4 w-4 text-stone-400 transition-transform duration-200'
            />
          </button>

          <div id='mobile-watches-content' class='hidden'>
            <div class='flex flex-col gap-3'>
              {megaMenuData.map((col) => (
                <div class='flex flex-col gap-2'>
                  <a href={col.href} class='block'>
                    <p class='text-[10px] font-bold tracking-wider'>{col.title}</p>
                  </a>
                  <div class='flex flex-col gap-1 pl-2'>
                    {col.items.map((item) => {
                      const isActive = currentPath === item.href;
                      return (
                        <a
                          href={item.href}
                          class={`block text-[11px] normal-case transition-colors ${
                            isActive
                              ? 'font-bold'
                              : 'text-stone-600 hover:font-bold hover:text-brand-dark'
                          }`}
                        >
                          {item.label}
                        </a>
                      );
                    })}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        <a href='/archives' class='py-2 text-stone-800 hover:text-brand-dark'>
          Archives
        </a>
        <a href='/about-us' class='py-2 text-stone-800 hover:text-brand-dark'>
          About Us
        </a>

        <SearchBox id='mobile-search' className='pt-4' />
      </nav>

      <div class='mt-auto flex flex-col gap-2 border-t border-stone-200 pt-6 text-xs text-stone-500'>
        <p>
          WhatsApp:{' '}
          <a href={CONTACT.whatsappLink} class='font-medium text-brand-dark'>
            {CONTACT.whatsapp}
          </a>
        </p>
        <p>
          Email:{' '}
          <a href={CONTACT.emailLink} class='font-medium text-brand-dark'>
            {CONTACT.email}
          </a>
        </p>
      </div>
    </div>
  </div>
</header>

<script>
  import { formatHeaderClock } from '@/lib/utils/format';

  const clockEl = document.getElementById('header-live-clock');
  if (clockEl) {
    const tick = () => {
      clockEl.textContent = formatHeaderClock(new Date());
    };
    setInterval(tick, 1000);
  }

  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const closeBtn = document.getElementById('mobile-menu-close');
  const drawer = document.getElementById('mobile-drawer');
  const drawerContent = document.getElementById('mobile-drawer-content');
  const watchesToggle = document.getElementById('mobile-watches-toggle');
  const watchesContent = document.getElementById('mobile-watches-content');
  const watchesIcon = document.getElementById('mobile-watches-icon');

  const watchesWrapper = document.getElementById('watches-menu-wrapper');
  const watchesMegaMenu = document.getElementById('watches-mega-menu');
  const watchesChevron = document.getElementById('watches-chevron');
  let closeTimer: ReturnType<typeof setTimeout> | null = null;

  function showMegaMenu() {
    if (closeTimer) {
      clearTimeout(closeTimer);
      closeTimer = null;
    }
    watchesMegaMenu?.classList.remove('invisible', 'opacity-0', 'pointer-events-none');
    watchesMegaMenu?.classList.add('visible', 'opacity-100', 'pointer-events-auto');
    watchesChevron?.classList.add('rotate-180');
  }

  function scheduleHideMegaMenu() {
    if (closeTimer) clearTimeout(closeTimer);
    closeTimer = setTimeout(() => {
      watchesMegaMenu?.classList.remove('visible', 'opacity-100', 'pointer-events-auto');
      watchesMegaMenu?.classList.add('invisible', 'opacity-0', 'pointer-events-none');
      watchesChevron?.classList.remove('rotate-180');
      closeTimer = null;
    }, 280);
  }

  watchesWrapper?.addEventListener('mouseenter', showMegaMenu);
  watchesWrapper?.addEventListener('mouseleave', scheduleHideMegaMenu);
  watchesMegaMenu?.addEventListener('mouseenter', showMegaMenu);
  watchesMegaMenu?.addEventListener('mouseleave', scheduleHideMegaMenu);

  function openMenu() {
    drawer?.classList.remove('opacity-0', 'pointer-events-none');
    drawer?.classList.add('opacity-100');
    drawerContent?.classList.remove('-translate-x-full');
    drawerContent?.classList.add('translate-x-0');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    drawer?.classList.add('opacity-0', 'pointer-events-none');
    drawer?.classList.remove('opacity-100');
    drawerContent?.classList.add('-translate-x-full');
    drawerContent?.classList.remove('translate-x-0');
    document.body.style.overflow = '';
  }

  toggleBtn?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  drawer?.addEventListener('click', (event) => {
    if (event.target === drawer) closeMenu();
  });

  watchesToggle?.addEventListener('click', () => {
    const isHidden = watchesContent?.classList.contains('hidden');
    if (isHidden) {
      watchesContent?.classList.remove('hidden');
      watchesIcon?.classList.add('rotate-180');
    } else {
      watchesContent?.classList.add('hidden');
      watchesIcon?.classList.remove('rotate-180');
    }
  });

  const searchToggle = document.getElementById('header-search-toggle');
  const searchPanel = document.getElementById('header-search-panel');
  const searchInput = document.getElementById('header-search-input');
  const searchWrapper = document.getElementById('header-search');

  function openSearchPanel() {
    searchPanel?.classList.remove('invisible', 'opacity-0', 'pointer-events-none', 'translate-y-1');
    searchPanel?.classList.add('visible', 'opacity-100', 'pointer-events-auto', 'translate-y-0');
    searchToggle?.setAttribute('aria-expanded', 'true');
    const panelHeight = searchPanel?.offsetHeight;
    if (panelHeight !== undefined && document.activeElement !== searchInput) searchInput?.focus();
  }

  function closeSearchPanel() {
    searchPanel?.classList.remove('visible', 'opacity-100', 'pointer-events-auto', 'translate-y-0');
    searchPanel?.classList.add('invisible', 'opacity-0', 'pointer-events-none', 'translate-y-1');
    searchToggle?.setAttribute('aria-expanded', 'false');
  }

  searchToggle?.addEventListener('click', () => {
    if (searchToggle.getAttribute('aria-expanded') === 'true') {
      closeSearchPanel();
      searchToggle.focus();
    } else {
      openSearchPanel();
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && searchToggle?.getAttribute('aria-expanded') === 'true') {
      closeSearchPanel();
      searchToggle.focus();
    }
  });

  document.addEventListener('click', (event) => {
    if (searchToggle?.getAttribute('aria-expanded') !== 'true') return;
    if (event.target instanceof Node && searchWrapper?.contains(event.target)) return;
    closeSearchPanel();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== '/' || searchToggle?.getAttribute('aria-expanded') === 'true') return;
    const target = event.target;
    const isTyping =
      target instanceof HTMLElement &&
      (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable);
    if (isTyping) return;
    if (searchWrapper?.offsetParent === null) return;
    event.preventDefault();
    openSearchPanel();
  });
</script>
