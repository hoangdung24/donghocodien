---
import type { Product, ProductCategory } from '@/lib/schema/product';
import { WatchCard } from '@/components/WatchCard';

interface Props {
  product: Product;
  categories?: ProductCategory[];
  slideCount: number;
}

const { product, categories = [], slideCount } = Astro.props;
---

<div
  class='min-w-0 flex-[0_0_80%] pl-4 sm:flex-[0_0_50%] sm:pl-6 lg:flex-[0_0_25%]'
  role='group'
  aria-roledescription='slide'
  aria-label={`1 of ${slideCount}`}
>
  <WatchCard product={product} categories={categories} />
</div>
