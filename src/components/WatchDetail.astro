---
import Layout from '@/layouts/Layout.astro';
import { ApproxPrice } from '@/components/ApproxPrice';
import { WatchGallery } from '@/components/WatchGallery';
import { AddToCartButton } from '@/components/AddToCartButton';
import { ProductTabs } from '@/components/ProductTabs';
import { RelatedProducts } from '@/components/RelatedProducts';
import { buttonClass } from '@/components/Button';
import { Mail, MessageCircle } from '@lucide/astro';
import type { Product, ProductCategory } from '@/lib/schema/product';
import { findBrandCategory } from '@/lib/utils/categories';
import { CONTACT } from '@/lib/constants';
import {
  demoteEmbeddedHeadings,
  leadHeadingRepeatsSection,
  sanitizeWordPressHtml,
} from '@/lib/utils/html';
import { cleanTitle } from '@/lib/utils/text';

interface Props {
  product: Product;
  relatedProducts: Product[];
  categories: ProductCategory[];
}

const { product, relatedProducts, categories } = Astro.props;

const cleanName = cleanTitle(product.name);
const cleanDescription = await demoteEmbeddedHeadings(
  await sanitizeWordPressHtml(product.description || '')
);
const cleanShortDescription = await sanitizeWordPressHtml(product.short_description || '');
const descriptionRepeatsHeading = leadHeadingRepeatsSection(cleanDescription, 'Description');
const primaryBrand = findBrandCategory(product, categories);

const stockText = product.is_in_stock
  ? `${product.low_stock_remaining ? `${product.low_stock_remaining} in stock` : 'In stock'}`
  : 'Sold';
const stockClass = product.is_in_stock ? 'text-green-700' : 'text-stone-700';

const displayedPrice = Number(product.prices.price);
const hasPrice = displayedPrice > 0;

const soldEnquiryText = encodeURIComponent(
  `Hello Spacetime Vintage Watch, I am interested in a watch similar to "${cleanName}".`
);
const soldEnquiryLink = `${CONTACT.whatsappLink}?text=${soldEnquiryText}`;
const soldEmailSubject = encodeURIComponent(`Enquiry about ${cleanName}`);

const productSchema = {
  name: cleanName,
  brand: primaryBrand?.name || 'Spacetime Vintage Watch',
  sku: product.sku || product.id.toString(),
  price: hasPrice ? displayedPrice : undefined,
  currency: 'USD',
  availability: product.is_in_stock ? ('in_stock' as const) : ('out_of_stock' as const),
  url: `/watches/${product.slug}`,
  image:
    product.images[0]?.src ||
    'https://donghocodien.com/wp-content/uploads/2025/09/ref-200246-1-1.jpg',
};
---

<Layout
  title={cleanName}
  description={product.short_description.replace(/<[^>]*>?/gm, '').slice(0, 160)}
  image={product.images[0]?.src}
  type='product'
  product={productSchema}
>
  <main class='mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-16 lg:px-8'>
    <nav aria-label='Breadcrumb' class='mb-8'>
      <ol class='flex flex-wrap items-center gap-2 font-sans text-xs tracking-wider text-stone-600 uppercase'>
        <li>
          <a href='/' class='transition-colors hover:text-stone-900'>
            Home
          </a>
        </li>
        <li aria-hidden='true'>/</li>
        <li>
          <a href='/watches' class='transition-colors hover:text-stone-900'>
            Collection
          </a>
        </li>
        {primaryBrand && (
          <>
            <li aria-hidden='true'>/</li>
            <li>
              <a
                href={`/watches?category=${primaryBrand.slug}`}
                class='transition-colors hover:text-stone-900'
              >
                {cleanTitle(primaryBrand.name)}
              </a>
            </li>
          </>
        )}
        <li aria-hidden='true'>/</li>
        <li class='max-w-xs truncate text-stone-900' aria-current='page'>
          {cleanName}
        </li>
      </ol>
    </nav>

    <div class='grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-16'>
      <div class='lg:col-span-7'>
        <WatchGallery client:visible images={product.images} title={cleanName} />
      </div>

      <div class='flex flex-col lg:col-span-5'>
        {primaryBrand && (
          <p class='mb-4 text-xs font-medium tracking-[0.25em] uppercase'>
            {cleanTitle(primaryBrand.name)}
          </p>
        )}

        <h1 class='mb-7 text-3xl leading-tight font-normal text-stone-950 sm:text-4xl'>
          {cleanName}
        </h1>

        <div class='flex flex-col'>
          <div class='flex items-baseline gap-4'>
            {hasPrice ? (
              <>
                <span class='text-3xl font-medium text-stone-900'>${product.prices.price}</span>
                {product.on_sale && product.prices.regular_price && (
                  <span class='text-base text-stone-500 line-through'>
                    <span class='sr-only'>Original price: </span>${product.prices.regular_price}
                  </span>
                )}
              </>
            ) : (
              <div class='flex items-baseline gap-3'>
                <span class='text-[11px] font-medium tracking-[0.25em] text-stone-500 uppercase'>
                  Sold
                </span>
                <span class='text-sm text-stone-500'>Price on request</span>
              </div>
            )}
          </div>
          {hasPrice && <ApproxPrice client:visible usdPrice={product.prices.price} />}
        </div>

        {cleanShortDescription && (
          <div class='mt-10 border-t border-stone-200 pt-7 text-sm leading-relaxed text-stone-700'>
            <div set:html={cleanShortDescription} />
          </div>
        )}

        <div class='mt-10'>
          {product.is_in_stock ? (
            <AddToCartButton
              client:visible
              product={product}
              stockText={stockText}
              stockClass={stockClass}
            />
          ) : (
            <div class='flex flex-col gap-4 border-t border-stone-200 pt-7'>
              <div class='flex items-center justify-between text-sm'>
                <span class='font-medium text-stone-900'>Availability:</span>
                <span class={`font-medium ${stockClass}`}>{stockText}</span>
              </div>
              <p class='text-sm leading-relaxed text-stone-600'>
                This piece has found its owner. Tell us what you are looking for and we will let you
                know when a comparable timepiece arrives.
              </p>
              <div class='flex flex-col gap-3 sm:flex-row'>
                <a
                  href={soldEnquiryLink}
                  target='_blank'
                  rel='noopener noreferrer'
                  class={buttonClass('primary', 'md', 'w-full sm:w-auto')}
                >
                  <MessageCircle class='h-5 w-5' aria-hidden='true' />
                  Ask on WhatsApp
                </a>
                <a
                  href={`${CONTACT.emailLink}?subject=${soldEmailSubject}`}
                  class={buttonClass('outline', 'md', 'w-full sm:w-auto')}
                >
                  <Mail class='h-5 w-5' aria-hidden='true' />
                  Email Us
                </a>
              </div>
            </div>
          )}
        </div>
      </div>
    </div>

    <div class='mt-12 lg:mt-16'>
      <ProductTabs
        client:visible
        descriptionHtml={cleanDescription}
        sku={product.sku}
        shortDescription={cleanShortDescription}
        hideHeading={descriptionRepeatsHeading}
      />

      {relatedProducts.length > 0 && (
        <RelatedProducts
          client:visible
          products={relatedProducts}
          categories={categories}
          title='Similar Watches'
          country={null}
          className='mt-12'
        />
      )}
    </div>
  </main>
</Layout>
