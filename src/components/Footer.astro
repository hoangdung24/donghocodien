---
const year = new Date().getFullYear();
---

<footer class="bg-stone-900 text-stone-300 border-t border-stone-800 mt-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12">
      {/* Brand Column */}
      <div class="md:col-span-1 space-y-4">
        <h3 class="font-serif text-2xl text-stone-100 tracking-wide font-bold">
          DONG HO CO DIEN
        </h3>
        <p class="text-xs text-stone-400 leading-relaxed font-sans">
          A dedicated sanctuary for discerning collectors passionate about mechanical craftsmanship and timeless horological heritage.
        </p>
        <p class="text-xs text-amber-500 font-mono">
          Showroom &amp; Authentication Atelier in Ho Chi Minh City
        </p>
      </div>

      {/* Navigation */}
      <div>
        <h4 class="font-serif text-sm uppercase tracking-widest text-stone-200 mb-4">
          Discover
        </h4>
        <ul class="space-y-2 text-xs text-stone-400">
          <li><a href="/shop" class="hover:text-stone-100 transition-colors">All Timepieces</a></li>
          <li><a href="/shop?filter=omega" class="hover:text-stone-100 transition-colors">Vintage Omega</a></li>
          <li><a href="/shop?filter=cartier" class="hover:text-stone-100 transition-colors">Cartier Tank</a></li>
          <li><a href="/shop?filter=rolex" class="hover:text-stone-100 transition-colors">Vintage Rolex</a></li>
          <li><a href="/blog" class="hover:text-stone-100 transition-colors">Collector's Journal</a></li>
        </ul>
      </div>

      {/* Customer Service & Policies */}
      <div>
        <h4 class="font-serif text-sm uppercase tracking-widest text-stone-200 mb-4">
          Client Care &amp; Terms
        </h4>
        <ul class="space-y-2 text-xs text-stone-400">
          <li><a href="/warranty-policy" class="hover:text-stone-100 transition-colors">Warranty &amp; Guarantee</a></li>
          <li><a href="/refund_returns" class="hover:text-stone-100 transition-colors">Returns &amp; Exchanges</a></li>
          <li><a href="/payment-and-delivery" class="hover:text-stone-100 transition-colors">Worldwide Shipping &amp; Payment</a></li>
          <li><a href="/terms-and-conditions" class="hover:text-stone-100 transition-colors">Terms of Service</a></li>
          <li><a href="/privacy-policy" class="hover:text-stone-100 transition-colors">Privacy Policy</a></li>
        </ul>
      </div>

      {/* Boutique & Contact */}
      <div class="space-y-3">
        <h4 class="font-serif text-sm uppercase tracking-widest text-stone-200 mb-4">
          Boutique Concierge
        </h4>
        <p class="text-xs text-stone-400 leading-relaxed">
          WhatsApp / Call: <a href="https://wa.me/84901234567" class="text-stone-200 hover:underline">+84 90 123 4567</a>
        </p>
        <p class="text-xs text-stone-400 leading-relaxed">
          Email: <a href="mailto:contact@donghocodien.com" class="text-stone-200 hover:underline">contact@donghocodien.com</a>
        </p>
        <p class="text-xs text-stone-400 leading-relaxed">
          Visiting Hours: 09:30 – 19:30 (Mon – Sat, GMT+7)
        </p>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-stone-800 text-center text-xs text-stone-500 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p>&copy; {year} donghocodien.com. All rights reserved.</p>
      <p class="text-[11px] text-stone-400">
        Engineered with Astro &amp; Effect Functional Architecture.
      </p>
    </div>
  </div>
</footer>
