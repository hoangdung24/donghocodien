---
const year = new Date().getFullYear();
---

<footer id="footer" class="mt-20 border-t border-stone-200">
  {/* The 3 Signature Feature Blocks from donghocodien.com */}
  <section class="border-b border-stone-200 bg-[#e4e4e4] text-stone-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-stone-300">
        <a
          href="/warranty-policy"
          class="py-4 sm:py-5 px-6 text-center block hover:bg-stone-300/40 transition-colors group"
        >
          <h3 class="text-xs sm:text-sm uppercase tracking-[0.2em] font-semibold text-stone-900 group-hover:text-stone-600 transition-colors">
            6 MONTHS WARRANTY
          </h3>
        </a>

        <a
          href="/payment-and-delivery"
          class="py-4 sm:py-5 px-6 text-center block hover:bg-stone-300/40 transition-colors group"
        >
          <h3 class="text-xs sm:text-sm uppercase tracking-[0.2em] font-semibold text-stone-900 group-hover:text-stone-600 transition-colors">
            SHIPPING WORLDWIDE
          </h3>
        </a>

        <a
          href="/exchange-policy"
          class="py-4 sm:py-5 px-6 text-center block hover:bg-stone-300/40 transition-colors group"
        >
          <h3 class="text-xs sm:text-sm uppercase tracking-[0.2em] font-semibold text-stone-900 group-hover:text-stone-600 transition-colors">
            EXCHANGE POLICY
          </h3>
        </a>
      </div>
    </div>
  </section>

  {/* Main Footer Content */}
  <div class="bg-white text-stone-800 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">
        {/* Brand & Mission */}
        <div class="space-y-4">
          <img src="/images/logo.png" alt="Spacetime" class="h-10 w-auto object-contain" />
          <p class="text-xs text-stone-500 leading-relaxed font-sans max-w-xs">
            A dedicated atelier curating rare, authentic mechanical vintage timepieces from Switzerland and Japan for global collectors.
          </p>
        </div>

        {/* About & Policies */}
        <div>
          <h4 class="text-xs uppercase tracking-[0.2em] font-bold text-stone-900 mb-4">
            About Us
          </h4>
          <ul class="space-y-2.5 text-xs text-stone-600 uppercase tracking-wider">
            <li><a href="/warranty-policy" class="hover:text-stone-950 transition-colors">Warranty Policy</a></li>
            <li><a href="/exchange-policy" class="hover:text-stone-950 transition-colors">Exchange Policy</a></li>
            <li><a href="/payment-and-delivery" class="hover:text-stone-950 transition-colors">Payment &amp; Shipping Methods</a></li>
            <li><a href="/consign-your-watch" class="hover:text-stone-950 transition-colors">Consign Your Watch</a></li>
            <li><a href="/privacy-policy" class="hover:text-stone-950 transition-colors">Privacy Policy</a></li>
          </ul>
        </div>

        {/* Contact info from live site */}
        <div>
          <h4 class="text-xs uppercase tracking-[0.2em] font-bold text-stone-900 mb-4">
            Contact
          </h4>
          <div class="space-y-2.5 text-xs text-stone-600">
            <p>
              Email: <a href="mailto:spacetime.donghocodien@gmail.com" class="text-stone-900 hover:underline">spacetime.donghocodien@gmail.com</a>
            </p>
            <p>
              WhatsApp: <a href="https://wa.me/84941625653" class="text-stone-900 hover:underline font-medium">+84 94 162 5653</a>
            </p>
            <p class="text-stone-500 pt-1">
              Location: Ho Chi Minh City, Vietnam
            </p>
          </div>
        </div>

        {/* Follow us & Social */}
        <div>
          <h4 class="text-xs uppercase tracking-[0.2em] font-bold text-stone-900 mb-4">
            Follow Us
          </h4>
          <ul class="space-y-2.5 text-xs text-stone-600 uppercase tracking-wider">
            <li>
              <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="hover:text-stone-950 transition-colors">
                Instagram &bull; @donghocodien
              </a>
            </li>
            <li>
              <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" class="hover:text-stone-950 transition-colors">
                Facebook &bull; Dong Ho Co Dien
              </a>
            </li>
          </ul>
        </div>
      </div>

      <div class="mt-16 pt-8 border-t border-stone-200 text-center text-xs text-stone-400 flex flex-col sm:flex-row items-center justify-between gap-4">
        <p>&copy; {year} Spacetime - Vintage Watch (donghocodien.com). All rights reserved.</p>
        <p class="text-[11px] text-stone-400">
          Powered by Astro &amp; Effect Functional Architecture.
        </p>
      </div>
    </div>
  </div>
</footer>
