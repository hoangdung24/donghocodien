---
import { WatchCard } from '@/components/WatchCard';
import { PriceRangeSlider } from '@/components/PriceRangeSlider';
import SearchBox from '@/components/SearchBox.astro';
import { CategoryAccordion } from '@/components/CategoryAccordion';
import { MobileFilterDrawer } from '@/components/MobileFilterDrawer';
import type { Product, ProductCategory } from '@/lib/schema/product';
import { buildCategoryTree } from '@/lib/utils/categories';
import { countInStockByCategory } from '@/lib/utils/products';

interface Props {
  products: Product[];
  categories: ProductCategory[];
  availableProducts: Product[];
  availableCategoryCounts?: Map<number, number>;
  priceBounds?: { minPrice: number; maxPrice: number };
  activeCategory: ProductCategory | null;
  search?: string;
  page?: number;
  hasNextPage?: boolean;
  basePath: string;
  hasPriceFilter?: boolean;
  minPriceFilter?: number;
  maxPriceFilter?: number;
}

const {
  products,
  categories,
  availableProducts,
  availableCategoryCounts,
  priceBounds,
  activeCategory,
  search,
  page = 1,
  hasNextPage = false,
  basePath,
  hasPriceFilter = false,
  minPriceFilter,
  maxPriceFilter,
} = Astro.props;

const searchQuery = search ?? '';
const categoryId = activeCategory?.id;
const canonicalCategory = activeCategory?.slug;
const inStockCounts = availableCategoryCounts ?? countInStockByCategory(availableProducts);

const categoryGroups = buildCategoryTree(categories)
  .map((group) => ({
    ...group,
    children: group.children.filter((category) => (inStockCounts.get(category.id) || 0) > 0),
  }))
  .filter((group) => group.children.length > 0);

const boundPrices =
  priceBounds === undefined
    ? availableProducts
        .filter((product) => product.is_in_stock && Number(product.prices.price) > 0)
        .map((product) => Number(product.prices.price))
    : [priceBounds.minPrice, priceBounds.maxPrice];
const minPrice = boundPrices.length > 0 ? Math.floor(Math.min(...boundPrices) / 100) * 100 : 0;
const maxPrice = boundPrices.length > 0 ? Math.ceil(Math.max(...boundPrices) / 100) * 100 : 100000;

const pageHref = (pageNumber: number): string | null => {
  if (pageNumber < 1) return null;
  const params = new URLSearchParams();
  if (search) params.set('search', search);
  if (canonicalCategory) params.set('category', canonicalCategory);
  if (hasPriceFilter) {
    params.set('min_price', String(minPriceFilter));
    params.set('max_price', String(maxPriceFilter));
  }
  if (pageNumber > 1) params.set('page', String(pageNumber));
  const queryString = params.toString();
  return `${basePath}${queryString ? `?${queryString}` : ''}`;
};
---

{availableCategoryCounts || availableProducts.length > 0 ? (
  <div class='grid grid-cols-1 gap-8 lg:grid-cols-12'>
    <aside aria-label='Filter timepieces' class='hidden lg:col-span-3 lg:flex lg:flex-col lg:gap-8'>
      <SearchBox
        id='shop-search'
        value={searchQuery}
        category={canonicalCategory}
        action={basePath}
      />

      <CategoryAccordion
        client:idle
        groups={categoryGroups}
        activeCategoryId={categoryId}
        search={search}
        basePath={basePath}
      />

      <PriceRangeSlider
        client:idle
        minPrice={minPrice}
        maxPrice={maxPrice}
        defaultMin={hasPriceFilter ? minPriceFilter : undefined}
        defaultMax={hasPriceFilter ? maxPriceFilter : undefined}
        basePath={basePath}
      />
    </aside>

    <MobileFilterDrawer client:idle resultCount={products.length}>
      <SearchBox
        slot='searchBox'
        id='shop-search-mobile'
        value={searchQuery}
        category={canonicalCategory}
        action={basePath}
      />

      <div slot='categoryAccordion'>
        <CategoryAccordion
          client:idle
          groups={categoryGroups}
          activeCategoryId={categoryId}
          search={search}
          basePath={basePath}
        />
      </div>

      <div slot='priceRangeSlider'>
        <PriceRangeSlider
          client:idle
          minPrice={minPrice}
          maxPrice={maxPrice}
          defaultMin={hasPriceFilter ? minPriceFilter : undefined}
          defaultMax={hasPriceFilter ? maxPriceFilter : undefined}
          basePath={basePath}
        />
      </div>
    </MobileFilterDrawer>

    <div class='lg:col-span-9'>
      <p
        role='status'
        class='mb-4 hidden font-sans text-xs tracking-widest text-stone-600 uppercase lg:block'
      >
        {products.length} {products.length === 1 ? 'timepiece' : 'timepieces'}
      </p>
      {products.length === 0 ? (
        <div class='py-24 text-center text-xs tracking-widest text-stone-600 uppercase'>
          No timepieces found matching this criteria.
        </div>
      ) : (
        <>
          <ul class='grid grid-cols-2 gap-4 sm:grid-cols-2 sm:gap-6 md:grid-cols-3 lg:grid-cols-4 lg:gap-8'>
            {products.map((watch) => (
              <li>
                <WatchCard client:visible product={watch} categories={categories} country={null} />
              </li>
            ))}
          </ul>

          {(page > 1 || hasNextPage) && (
            <nav
              class='mt-16 flex items-center justify-between border-t border-stone-200 pt-8'
              aria-label='Pagination'
            >
              {pageHref(page - 1) ? (
                <a
                  href={pageHref(page - 1)}
                  rel='prev'
                  class='inline-flex min-h-11 items-center border border-stone-300 px-5 py-2.5 text-xs tracking-widest uppercase transition-colors hover:bg-stone-100'
                >
                  &larr; Previous<span class='sr-only'> page</span>
                </a>
              ) : (
                <div aria-hidden='true' />
              )}

              <p class='font-sans text-xs tracking-widest text-stone-600 uppercase'>Page {page}</p>

              {hasNextPage ? (
                <a
                  href={pageHref(page + 1)}
                  rel='next'
                  class='inline-flex min-h-11 items-center border border-stone-300 px-5 py-2.5 text-xs tracking-widest uppercase transition-colors hover:bg-stone-100'
                >
                  Next<span class='sr-only'> page</span> &rarr;
                </a>
              ) : (
                <div aria-hidden='true' />
              )}
            </nav>
          )}
        </>
      )}
    </div>
  </div>
) : (
  <p class='border border-stone-200 bg-white px-6 py-24 text-center text-xs tracking-widest text-stone-600 uppercase'>
    No timepieces are available right now. Please try again shortly.
  </p>
)}
