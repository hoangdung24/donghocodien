{
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "astro": true,
  "plugins": ["astro", "jsx", "typescript"],
  "sortTailwindcss": {
    "stylesheet": "./src/styles/global.css",
    "functions": ["clsx", "cn"],
    "preserveWhitespace": true
  }
}
