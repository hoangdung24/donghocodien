    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.4",
    "effect": "^4.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "ultrahtml": "^1.7.0"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "^14.4.3",
    "@astrojs/compiler-rs": "^0.5.2",
