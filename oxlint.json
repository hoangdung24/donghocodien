{
  "$schema": "https://oxc.rs/oxlint.json",
  "ignorePatterns": ["dist/", "node_modules/", ".astro/", "*.d.ts"],
  "jsPlugins": ["oxlint-tailwindcss"],
  "rules": {
    "no-unused-vars": "error",
    "no-useless-escape": "error",
    "no-useless-spread": "error",
    "no-new-array": "error",
    "prefer-string-starts-ends-with": "error",
    "tailwindcss/no-unknown-classes": [
      "error",
      {
        "allowlist": [
          "woocommerce-tabs",
          "wc-tabs-wrapper",
          "tabbed-content",
          "woocommerce-Tabs-panel",
          "woocommerce-Tabs-panel--description",
          "panel"
        ]
      }
    ],
    "tailwindcss/no-conflicting-classes": "error",
    "tailwindcss/no-dynamic-classes": "error",
    "tailwindcss/no-deprecated-classes": "error",
    "tailwindcss/enforce-canonical": "error",
    "tailwindcss/enforce-sort-order": "error",
    "tailwindcss/no-duplicate-classes": "error",
    "tailwindcss/no-unnecessary-arbitrary-value": "error",
    "tailwindcss/consistent-variant-order": "error",
    "tailwindcss/no-contradicting-variants": "error",
    "tailwindcss/no-dark-without-light": "error"
  },
  "settings": {
    "tailwindcss": {
      "entryPoint": "./src/styles/global.css"
    }
  },
  "plugins": ["react", "typescript", "jsx-a11y"]
}
